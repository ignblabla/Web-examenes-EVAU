---
import { Image } from "astro:assets"
import { getCollection } from "astro:content"
import portada from "../assets/examen-selectividad-andalucia.png"
import EnlacesRelacionados, { type Enlace, type GrupoEnlaces } from "../components/EnlacesRelacionados.astro"
import Icon from "../components/Icon.astro"
import SubjectSymbol from "../components/SubjectSymbol.astro"
import { asignaturas, cursoDe } from "../data/asignaturas"
import { cursos, nombreExamen, rutaAnio, rutaExamen } from "../data/examenes"
import { editor, referenciaEditor, sitio } from "../data/sitio"
import Base from "../layouts/Base.astro"

// Tarjetas de la portada, agrupadas por área. Solo se muestran las asignaturas publicadas (indexables).
const tarjetas = [
  {
    slug: "matematicas-ii",
    grupo: "ciencias",
    symbol: "geometry",
    title: "Matemáticas II",
    description:
      "Los exámenes desde 2021 resueltos paso a paso, con el planteamiento, los cálculos y las figuras.",
    detail: "Álgebra · Geometría · Análisis · Probabilidad",
    className: "subject-card subject-card--math-two",
  },
  {
    slug: "matematicas-aplicadas",
    grupo: "ciencias",
    symbol: "graph",
    title: "Matemáticas CCSS",
    description:
      "Los exámenes desde 2021 resueltos paso a paso, con el planteamiento, los cálculos y las gráficas.",
    detail: "Álgebra · Funciones · Probabilidad · Inferencia",
    className: "subject-card subject-card--math",
  },
  {
    slug: "fisica",
    grupo: "ciencias",
    symbol: "atom",
    title: "Física",
    description:
      "Los exámenes desde 2021 resueltos paso a paso, con los esquemas, los cálculos y las unidades.",
    detail: "Gravitación · Campos · Ondas · Cuántica",
    className: "subject-card subject-card--physics",
  },
  {
    slug: "ingles",
    grupo: "idiomas",
    symbol: "english",
    title: "Inglés",
    description:
      "Todos los exámenes desde 2021, con cada respuesta del Reading y del Use of English explicada en español.",
    detail: "Reading · Use of English · Writing",
    className: "subject-card subject-card--english",
  },
  {
    slug: "frances",
    grupo: "idiomas",
    symbol: "french",
    title: "Francés",
    description:
      "Todos los exámenes desde 2021, con cada respuesta de la compréhension y la compétence linguistique explicada.",
    detail: "Compréhension · Compétence · Expression",
    className: "subject-card subject-card--french",
  },
] as const

const visibles = tarjetas
  .filter((t) => asignaturas.some((a) => a.slug === t.slug && a.indexable))
  .map((t, i) => ({ ...t, key: String(i + 1).padStart(2, "0"), href: `/${t.slug}/` }))
const grupos = [
  { titulo: "Ciencias", tarjetas: visibles.filter((t) => t.grupo === "ciencias") },
  { titulo: "Idiomas", tarjetas: visibles.filter((t) => t.grupo === "idiomas") },
].filter((g) => g.tarjetas.length > 0)
// Todas las tarjetas miden lo que una columna del grupo más grande; los grupos con menos
// tarjetas se centran. Si ningún grupo pasa de dos, las tarjetas son anchas.
const columnas = Math.max(...grupos.map((g) => g.tarjetas.length))
const numeros = ["Una", "Dos", "Tres", "Cuatro", "Cinco", "Seis", "Siete", "Ocho"]
const cuantas = numeros[visibles.length - 1] ?? String(visibles.length)

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    editor(Astro.site),
    {
      "@type": "WebSite",
      "@id": new URL("/#web", Astro.site).href,
      name: sitio.nombre,
      alternateName: sitio.nombreAlternativo,
      url: Astro.site?.href,
      inLanguage: "es",
      description: sitio.descripcion,
      publisher: referenciaEditor(Astro.site),
      audience: {
        "@type": "EducationalAudience",
        educationalRole: "student",
        audienceType: "Alumnado de 2.º de Bachillerato de Andalucía",
      },
    },
  ],
}

// Últimos tres cursos con exámenes, cada uno enlazado a su página en las asignaturas indexables.
const examenes = await getCollection("examenes")
const publicadas = asignaturas.filter((a) => a.indexable)
const anios = cursos
  .filter((c) => examenes.some((e) => e.data.anio === c.anio))
  .slice(0, 3)
  .map((c) => ({
    anio: c.anio,
    conExamenes: publicadas.filter((a) =>
      examenes.some((e) => e.data.asignatura === a.slug && e.data.anio === c.anio),
    ),
  }))

// Exámenes oficiales (junio y julio) del último curso, enlazados directamente.
const ultimo = cursos.find((c) => examenes.some((e) => e.data.anio === c.anio))
const ultimosExamenes: Enlace[] = ultimo
  ? publicadas.flatMap((a) =>
      ultimo.oficiales
        .filter((e) => examenes.some((x) => x.id === `${a.slug}/${ultimo.anio}/${e.slug}`))
        .map((e) => ({
          etiqueta: `${a.nombre} · ${e.tipo === "ordinaria" ? "Ordinaria" : "Extraordinaria"}`,
          texto: `Examen de ${a.nombre} de ${nombreExamen(ultimo.anio, e)} resuelto`,
          href: rutaExamen(a.slug, ultimo.anio, e),
        })),
    )
  : []
// Los mismos enlaces repartidos en dos mitades, Ciencias e Idiomas, según el grupo de cada tarjeta.
const grupoDe = (href: string) => tarjetas.find((t) => href.startsWith(`/${t.slug}/`))?.grupo
const ultimosGrupos: GrupoEnlaces[] = grupos.map((g) => ({
  titulo: g.titulo,
  enlaces: ultimosExamenes.filter((e) => grupoDe(e.href) === g.tarjetas[0].grupo),
}))
// Número de reservas del último curso, solo si es el mismo en todas las asignaturas publicadas
// (en Física de 2026 solo está la reserva 1).
const conteosReservas = new Set(ultimo ? publicadas.map((a) => cursoDe(a, ultimo).reservas.length) : [])
const reservasUltimo = conteosReservas.size === 1 ? [...conteosReservas][0] : undefined
---

<Base
  title="Exámenes de Selectividad Andalucía resueltos (PAU y PEvAU)"
  description="Exámenes de Matemáticas II, Matemáticas CCSS, Física, Inglés y Francés de Selectividad de Andalucía (PAU y PEvAU) resueltos y con soluciones, de 2021 a 2026."
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="eyebrow">
          <span class="eyebrow-dot"></span>
          Selectividad (PAU) · Andalucía
        </div>
        <h1>
          Exámenes resueltos
          <br />
          <em>de Selectividad.</em>
        </h1>
        <p class="hero-lead">
          Los exámenes de Matemáticas II, Matemáticas CCSS, Física, Inglés y Francés de la Selectividad de Andalucía
          (PAU, antes PEvAU) de 2021 a 2026, corregidos y con soluciones: el enunciado oficial y
          cada respuesta explicada para que entiendas el porqué y no solo el resultado.
        </p>
        <div class="hero-actions">
          <a href="#asignaturas" class="button button--primary">
            Explorar exámenes
            <Icon name="arrow-up-right" />
          </a>
          <a href="#metodo" class="text-link">
            Conoce nuestro método
            <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>

      <div class="hero-visual" aria-label="Ejemplo de resolución de un examen">
        <div class="formula-orbit formula-orbit--one">✓</div>
        <div class="paper-card paper-card--real">
          <Image
            src={portada}
            alt="Examen oficial de Selectividad de Andalucía"
            width={375}
            densities={[1, 2]}
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
    <div class="container hero-foot">
      <span>Exámenes oficiales</span>
      <span>Resoluciones revisadas</span>
      <span>Acceso libre</span>
    </div>
  </section>

  <section class="subjects section" id="asignaturas">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="section-index">01</span>
          <p class="section-kicker">Elige tu asignatura</p>
        </div>
        <h2>
          {cuantas} asignaturas.
          <br />
          <em>Un objetivo claro.</em>
        </h2>
        <p>
          Empieza por la asignatura que quieres preparar y avanza a tu ritmo con resoluciones
          completas.
        </p>
      </div>
      {
        grupos.map((grupo) => (
          <div class="subject-group">
            <h3 class="subject-group-title">{grupo.titulo}</h3>
            <div
              class:list={["subject-grid", { "subject-grid--ancha": columnas <= 2 }]}
              style={`--columnas: ${columnas}; --tarjetas: ${grupo.tarjetas.length}`}
            >
              {grupo.tarjetas.map((subject) => (
                <a href={subject.href} class={subject.className}>
                  <div class="subject-top">
                    <span class="subject-number">{subject.key}</span>
                    <span class="subject-arrow">
                      <Icon name="arrow-up-right" />
                    </span>
                  </div>
                  <div class="subject-symbol" aria-hidden="true">
                    <SubjectSymbol type={subject.symbol} />
                  </div>
                  <div class="subject-content">
                    <h4>{subject.title}</h4>
                    <p>{subject.description}</p>
                    <span class="subject-detail">{subject.detail}</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section latest" id="ultimos">
    <div class="container">
      <EnlacesRelacionados
        id="ultimos-examenes"
        titulo={`Últimos exámenes resueltos: Selectividad ${ultimo?.anio ?? ""}`}
        grupos={ultimosGrupos}
      />
      {
        ultimo && (
          <p class="latest-note">
            Y los {reservasUltimo && `${reservasUltimo} `}exámenes de reserva de {ultimo.anio} en{" "}
            {publicadas.map((a, i) => (
              <>
                {i > 0 && (i === publicadas.length - 1 ? " y " : ", ")}
                <a href={rutaAnio(a.slug, ultimo.anio)}>{`${a.nombre} ${ultimo.anio}`}</a>{i === publicadas.length - 1 && "."}
              </>
            ))}
          </p>
        )
      }
    </div>
  </section>

  <section class="method section" id="metodo">
    <div class="container method-grid">
      <div class="method-intro">
        <span class="section-index section-index--light">02</span>
        <p class="section-kicker section-kicker--light">Una forma mejor de estudiar</p>
        <h2>
          No memorices
          <br />
          la solución.
          <br />
          <em>Compréndela.</em>
        </h2>
      </div>
      <div class="method-list">
        <article>
          <span>01</span>
          <div>
            <h3>Enunciado original</h3>
            <p>Cada ejercicio conserva el contexto y la estructura del examen oficial.</p>
          </div>
        </article>
        <article>
          <span>02</span>
          <div>
            <h3>Razonamiento visible</h3>
            <p>
              En los idiomas citamos la línea del texto que justifica cada respuesta y explicamos en
              español la regla gramatical; en Matemáticas y Física, cada paso del planteamiento y del
              cálculo, con los esquemas y las unidades.
            </p>
          </div>
        </article>
        <article>
          <span>03</span>
          <div>
            <h3>Respuesta de examen</h3>
            <p>
              Una solución ordenada, rigurosa y fácil de reproducir el día de la prueba.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="exams section" id="convocatorias">
    <div class="container exams-grid">
      <div class="exam-copy">
        <span class="section-index">03</span>
        <p class="section-kicker">Archivo por convocatorias</p>
        <h2>
          Practica con
          <br />
          <em>exámenes reales.</em>
        </h2>
        <p>
          Consulta las pruebas organizadas por asignatura, año y convocatoria. Un archivo que
          crecerá contigo.
        </p>
        <a href="#asignaturas" class="button button--dark">
          Elegir asignatura
          <Icon name="arrow-up-right" />
        </a>
      </div>
      <div class="year-stack" aria-label="Convocatorias disponibles">
        {
          anios.map(({ anio, conExamenes }, index) => (
            <div class="year-row">
              <span class="year-status">{index === 0 ? "Última" : "Archivo"}</span>
              <strong>{anio}</strong>
              <div class="year-meta">
                {conExamenes.map((a) => (
                  <a href={rutaAnio(a.slug, anio)}>
                    {a.nombre} {anio}
                  </a>
                ))}
              </div>
              <Icon name="arrow-up-right" />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section faq" id="selectividad">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="section-index">04</span>
          <p class="section-kicker">La prueba, en breve</p>
        </div>
        <h2>
          La Selectividad de Andalucía,
          <br />
          <em>en siete respuestas.</em>
        </h2>
        <p>Lo que conviene saber antes de ponerte con los exámenes.</p>
      </div>
      <div class="faq-grid">
        <article>
          <h3>¿PAU, PEvAU o Selectividad?</h3>
          <p>
            Es la misma prueba con distintos nombres. Hasta 2024 se llamaba PEvAU (Prueba de
            Evaluación de Bachillerato para el Acceso a la Universidad) y desde 2025 es la PAU,
            Prueba de Acceso a la Universidad, como en casi todas las comunidades. De 2017 a 2024 el
            nombre general en España era EBAU (Evaluación de Bachillerato para el Acceso a la
            Universidad) y cada comunidad lo adaptaba: PEvAU en Andalucía, EvAU en Madrid… Casi todo
            el mundo la sigue llamando Selectividad.
          </p>
        </article>
        <article>
          <h3>¿Qué convocatorias hay?</h3>
          <p>
            Cada curso hay una convocatoria ordinaria en junio y una extraordinaria en julio.
            Además se preparan exámenes de reserva, versiones alternativas por si hay que sustituir
            el examen titular, que sirven igual para practicar.
          </p>
        </article>
        <article>
          <h3>¿Cómo es el examen de Inglés?</h3>
          <p>
            Tiene tres bloques: Reading (4 puntos), Use of English (3 puntos) y Writing (3 puntos).
            La redacción pedía unas 120 palabras hasta 2025 y desde 2026 pide de 140 a 180.
            <a href="/ingles/">Ver los exámenes de Inglés resueltos</a>.
          </p>
        </article>
        <article>
          <h3>¿Cómo es el examen de Francés?</h3>
          <p>
            Tiene tres bloques: compréhension, compétence linguistique y expression écrite. Hasta
            2025 valían 4, 2 y 4 puntos, con una redacción de 80 a 120 palabras; desde 2026 valen 5, 2
            y 3, y la redacción es de 120 a 150. <a href="/frances/">Ver los exámenes de Francés
            resueltos</a>.
          </p>
        </article>
        <article>
          <h3>¿Cómo es el examen de Matemáticas CCSS?</h3>
          <p>
            Dura hora y media y tiene cuatro ejercicios: álgebra o programación lineal (3 puntos),
            funciones (3 puntos) y dos de probabilidad y estadística (2 puntos cada uno), con dos
            opciones en algunos de ellos. En 2024 y 2025 eran cuatro bloques de 2.5 puntos; de 2021 a 2023 se elegían cuatro de ocho
            ejercicios.
            <a href="/matematicas-aplicadas/">Ver los exámenes de Matemáticas CCSS resueltos</a>.
          </p>
        </article>
        <article>
          <h3>¿Cómo es el examen de Matemáticas II?</h3>
          <p>
            Dura hora y media y tiene seis ejercicios de 2,5 puntos: dos obligatorios y dos bloques
            con optatividad, en los que se elige uno de los dos ejercicios. En 2025 eran siete, uno
            obligatorio y tres bloques de dos, en 2024, ocho en cuatro bloques de dos, y de 2021 a 2023 se elegían cuatro de ocho. Entran análisis (límites, derivadas e integrales),
            álgebra, geometría y probabilidad.
            <a href="/matematicas-ii/">Ver los exámenes de Matemáticas II resueltos</a>.
          </p>
        </article>
        <article>
          <h3>¿Cómo es el examen de Física?</h3>
          <p>
            Dura hora y media y tiene cuatro bloques: campo gravitatorio, campo electromagnético,
            vibraciones y ondas (con la óptica) y física relativista, cuántica y de partículas. Uno
            es obligatorio y en los otros tres se elige entre dos opciones. En cada bloque se
            responde una cuestión de razonar (1 punto) y un problema (1,5 puntos). En 2025 la
            cuestión era obligatoria en todos los bloques y solo se elegía el problema, en 2024
            cada bloque tenía dos ejercicios completos y se elegía uno, y de 2021 a 2023 se
            elegían libremente cuatro de los ocho ejercicios.
            <a href="/fisica/">Ver los exámenes de Física resueltos</a>.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="closing">
    <div class="container closing-inner">
      <Icon name="book-open" />
      <p>Preparar bien un examen empieza por <em>entenderlo de verdad.</em></p>
      <a href="#asignaturas" class="circle-link" aria-label="Ver asignaturas">
        <Icon name="arrow-up-right" />
      </a>
    </div>
  </section>
</Base>
