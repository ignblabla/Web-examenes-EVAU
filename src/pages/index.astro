---
import Base from '../layouts/Base.astro';
import FilaAsignatura from '../components/FilaAsignatura.astro';
import FilaExamen from '../components/FilaExamen.astro';
import Icono from '../components/Icono.astro';
import { asignaturas, areas, estiloAcento, getAsignatura, type Area } from '../config/asignaturas';
import { examenes, estadisticas, estructura, urlExamen, nombreConvocatoria } from '../lib/examenes';

const todos = await examenes();
const stats = await estadisticas();
const resueltos = todos.filter((e) => e.data.resuelto);

const porAsignatura = (slug: string) => {
  const lista = todos.filter((e) => e.data.asignatura === slug);
  const anios = lista.map((e) => e.data.anio);
  return {
    total: lista.length,
    resueltos: lista.filter((e) => e.data.resuelto).length,
    desde: anios.length ? Math.min(...anios) : undefined,
    hasta: anios.length ? Math.max(...anios) : undefined,
  };
};

const disponibles = asignaturas.filter((a) => a.disponible);
const pronto = asignaturas.filter((a) => !a.disponible);
const prontoPorArea = (Object.keys(areas) as Area[])
  .map((area) => ({ area, nombre: areas[area], lista: pronto.filter((a) => a.area === area) }))
  .filter((g) => g.lista.length);

// Muestra de la portada: el examen más reciente resuelto, su primer ejercicio.
// Se toma de la primera asignatura de la configuración que tenga exámenes resueltos.
const muestra = disponibles.map((a) => resueltos.find((e) => e.data.asignatura === a.slug)).find(Boolean)!;
const muestraAsig = getAsignatura(muestra.data.asignatura)!;
const muestraEj = estructura(muestra.body)[0]?.ejercicios[0];
---
<Base
  titulo="Exámenes PEvAU Andalucía resueltos paso a paso | Selectividad"
  descripcion="Exámenes reales de la PEvAU (Selectividad) de Andalucía resueltos paso a paso por una profesora de Física. Practica con cronómetro y soluciones ocultas."
  seccion="inicio"
>
  <section class="portada wrap" aria-labelledby="portada-titulo">
    <div class="portada__texto">
      <h1 id="portada-titulo" class="display portada__h1">
        Exámenes reales de la PEvAU de Andalucía, <span>resueltos paso a paso.</span>
      </h1>
      <p class="portada__lede">
        Hazlos como el día de la prueba: con el reloj en marcha y las soluciones tapadas. Después, corrige
        apartado por apartado con la resolución de una profesora de Física con más de veinte años en el aula.
      </p>
      <div class="portada__acciones">
        <a class="btn btn--tinta btn--grande" href="#asignaturas">Elige asignatura <Icono nombre="flecha" /></a>
        <a class="btn btn--grande btn--sutil" href="/buscar/"><Icono nombre="buscar" /> Buscar un ejercicio</a>
      </div>

      <dl class="form form--4 portada__datos" aria-label="Qué hay en el archivo">
        <div class="form__campo"><dt class="form__rotulo">Años</dt><dd class="form__valor form__valor--grande num">{stats.desde}–{stats.hasta}</dd></div>
        <div class="form__campo"><dt class="form__rotulo">Convocatorias</dt><dd class="form__valor">Ordinaria y extraordinaria</dd></div>
        <div class="form__campo"><dt class="form__rotulo">Exámenes resueltos</dt><dd class="form__valor form__valor--grande num">{stats.resueltos}</dd></div>
        <div class="form__campo"><dt class="form__rotulo">Ejercicios resueltos</dt><dd class="form__valor form__valor--grande num">{stats.ejercicios}</dd></div>
        <div class="form__campo form__campo--ancho portada__autora">
          <dt class="form__rotulo">Resuelve</dt>
          <dd class="form__valor">María Luisa Aguirre <span>Graduada en Física · más de 20 años de docencia</span></dd>
        </div>
      </dl>
    </div>

    {muestraEj && (
      <a class="hoja" href={`${urlExamen(muestra)}#ej-${muestraEj.id}`} data-acento style={estiloAcento(muestraAsig)} aria-label={`Abrir ${muestra.data.titulo}, ejercicio ${muestraEj.id}`}>
        <span class="hoja__banda" aria-hidden="true"></span>
        <span class="hoja__cab">
          <span class="hoja__campo"><span class="form__rotulo">Asignatura</span><b>{muestraAsig.nombreCorto}</b></span>
          <span class="hoja__campo"><span class="form__rotulo">Convocatoria</span><b>{nombreConvocatoria(muestra.data.convocatoria)} {muestra.data.anio}</b></span>
          <span class="hoja__campo"><span class="form__rotulo">Duración</span><b class="num">{muestra.data.duracion} min</b></span>
        </span>
        <span class="hoja__ej">
          <span class="hoja__num">{muestraEj.id}</span>
          <span class="hoja__txt">{muestraEj.texto}</span>
          <span class="hoja__pts num">{muestraEj.puntos} p</span>
        </span>
        {muestraEj.apartados.map((ap) => (
          <span class="hoja__ap">
            <span class="hoja__letra"><span class="casilla" aria-hidden="true"></span>{ap.letra})</span>
            <span class="hoja__txt">{ap.texto}</span>
            <span class="hoja__pts num">{ap.puntos}</span>
          </span>
        ))}
        <span class="hoja__tapa">
          <span>Solución tapada: inténtalo primero</span>
          <span class="hoja__abrir">Abrir examen <Icono nombre="flecha" tamano={18} /></span>
        </span>
      </a>
    )}
  </section>

  <section id="asignaturas" class="wrap bloque-inicio" aria-labelledby="asig-titulo">
    <div class="seccion-cab">
      <h2 id="asig-titulo">Elige asignatura</h2>
      <p>{disponibles.length} disponibles · {pronto.length} en preparación</p>
    </div>
    <ul class="lista-limpia">
      {disponibles.map((a) => <FilaAsignatura asignatura={a} {...porAsignatura(a.slug)} />)}
    </ul>

    <div class="pronto">
      <h3 class="pronto__titulo caps">Próximas asignaturas</h3>
      <div class="pronto__areas">
        {prontoPorArea.map((g) => (
          <div>
            <h4 class="pronto__area">{g.nombre}</h4>
            <ul class="lista-limpia">{g.lista.map((a) => <FilaAsignatura asignatura={a} />)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap bloque-inicio" aria-labelledby="partido-titulo">
    <div class="instr instr--grande">
      <h2 id="partido-titulo" class="instr__titulo">Cómo sacarle partido</h2>
      <ol class="pasos">
        <li>
          <strong>Intenta el examen entero sin mirar.</strong>
          Las soluciones están tapadas por defecto. Equivocarte aquí es gratis; el día de la prueba, no.
        </li>
        <li>
          <strong>Cronométrate.</strong>
          Activa el reloj de la carátula: 90 minutos, como en la PEvAU. Aprenderás a repartir el tiempo entre bloques.
        </li>
        <li>
          <strong>Corrige apartado por apartado.</strong>
          Destapa solo el apartado que quieres comprobar, compara el resultado final y apunta el error típico en el que caíste.
        </li>
      </ol>
    </div>
  </section>

  <section class="wrap bloque-inicio" aria-labelledby="ultimos-titulo">
    <div class="seccion-cab">
      <h2 id="ultimos-titulo">Últimos exámenes resueltos</h2>
      <p>Todas las asignaturas</p>
    </div>
    <ul class="lista-limpia">
      {resueltos.slice(0, 5).map((e) => <FilaExamen examen={e} mostrarAsignatura />)}
    </ul>
  </section>
</Base>

<style>
  .lista-limpia { list-style: none; padding: 0; }

  .portada {
    display: grid;
    gap: var(--s-7);
    padding-top: var(--s-6);
    padding-bottom: var(--s-7);
  }
  .portada__h1 { font-size: min(var(--t-3xl), 4.5rem); max-width: 17ch; }
  .portada__h1 span { color: var(--ink-2); }
  .portada__lede {
    margin-top: var(--s-5);
    max-width: 52ch;
    font-size: var(--t-md);
    line-height: 1.55;
    color: var(--ink-2);
  }
  .portada__acciones { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-5); }
  .portada__acciones .btn { flex: 1 1 14rem; }
  .portada__datos { margin-top: var(--s-6); }
  .portada__autora dd span {
    display: block; margin-top: 0.1rem;
    font: 400 var(--t-sm)/1.4 var(--f-read); font-stretch: 100%;
    color: var(--ink-2);
  }

  /* La hoja: una muestra real del examen, en formato de cuadernillo */
  .hoja {
    display: block; align-self: start;
    background: var(--paper-2);
    border: var(--b-form) solid var(--rule-ink);
    box-shadow: var(--shadow-float);
    text-decoration: none;
    rotate: -1.2deg;
    transition: rotate var(--dur-3) var(--ease-out), translate var(--dur-3) var(--ease-out);
  }
  .hoja:hover { rotate: 0deg; translate: 0 -4px; }
  .hoja > span { display: grid; }
  .hoja__banda { height: var(--b-band); background: var(--acc); }
  .hoja__cab { grid-template-columns: repeat(3, minmax(0, 1fr)); border-bottom: var(--b-form) solid var(--rule-ink); }
  .hoja__campo { padding: var(--s-2) var(--s-3); border-right: var(--b-hair) solid var(--rule-ink); min-width: 0; }
  .hoja__campo:last-child { border-right: 0; }
  .hoja__campo b { display: block; font: 650 var(--t-sm)/1.25 var(--f-frame); font-stretch: 90%; }
  .hoja__ej, .hoja__ap {
    grid-template-columns: 2.75rem minmax(0, 1fr) 3.25rem;
    border-bottom: var(--b-hair) solid var(--rule);
  }
  .hoja__ej { border-bottom-color: var(--rule-ink); }
  .hoja__num { font: 800 var(--t-md)/1 var(--f-frame); font-stretch: var(--stretch-frame); padding: var(--s-3) 0 0 var(--s-3); color: var(--acc); }
  .hoja__letra { display: flex; gap: var(--s-1); align-items: flex-start; font: 700 var(--t-sm)/1 var(--f-frame); padding: var(--s-3) 0 0 var(--s-3); }
  .hoja__letra .casilla { width: 0.75rem; height: 0.75rem; margin-top: 0.05rem; }
  .hoja__txt { font-size: var(--t-sm); line-height: 1.5; padding: var(--s-2) var(--s-3) var(--s-3) 0; }
  .hoja__pts {
    border-left: var(--b-hair) solid var(--rule);
    padding: var(--s-3) var(--s-3) 0 0; text-align: right;
    font: 700 var(--t-xs)/1 var(--f-frame); color: var(--ink-2);
  }
  .hoja__tapa {
    grid-template-columns: 1fr auto; align-items: center; gap: var(--s-3);
    margin: var(--s-3); padding: var(--s-3);
    border: var(--b-form) dashed var(--ink-2);
    font: 650 var(--t-xs)/1.2 var(--f-frame); font-stretch: var(--stretch-frame);
    text-transform: uppercase; letter-spacing: var(--track-caps); color: var(--ink-2);
  }
  .hoja__abrir { display: inline-flex; align-items: center; gap: var(--s-1); color: var(--acc); }

  .bloque-inicio { margin-top: var(--s-8); }

  .pronto { margin-top: var(--s-7); }
  .pronto__titulo { font-size: var(--t-sm); color: var(--ink-2); margin-bottom: var(--s-4); }
  .pronto__areas { display: grid; gap: var(--s-5); }
  .pronto__area { font: 500 var(--t-sm)/1.3 var(--f-read); font-style: italic; color: var(--ink-3); margin-bottom: var(--s-2); }

  .instr--grande { padding: var(--s-5); font-size: var(--t-base); }
  .instr--grande .instr__titulo { font-size: var(--t-sm); margin-bottom: var(--s-4); }
  .pasos { display: grid; gap: var(--s-5); padding-left: 1.75rem; }
  .pasos li { color: var(--ink-2); line-height: 1.55; padding-left: var(--s-2); }
  .pasos li::marker { font: 800 var(--t-lg) var(--f-frame); font-stretch: var(--stretch-frame); color: var(--ink); }
  .pasos strong {
    display: block; margin-bottom: var(--s-1);
    font: 800 var(--t-md)/1.15 var(--f-frame); font-stretch: var(--stretch-frame);
    text-transform: uppercase; letter-spacing: 0.02em; color: var(--ink);
  }

  @media (min-width: 48rem) {
    .pronto__areas { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-6); }
    .pasos { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-6); }
  }
  @media (min-width: 64rem) {
    .portada { grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); align-items: start; gap: var(--s-8); padding-top: var(--s-8); }
    .hoja { margin-top: var(--s-6); }
  }
  @media (prefers-reduced-motion: reduce) { .hoja { rotate: 0deg; } }
</style>
