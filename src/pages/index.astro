---
import Icon from "../components/Icon.astro"
import SubjectSymbol from "../components/SubjectSymbol.astro"
import Base from "../layouts/Base.astro"

const subjects = [
  {
    key: "01",
    symbol: "english",
    title: "Inglés",
    description:
      "Textos y ejercicios resueltos con explicaciones claras de cada respuesta.",
    detail: "Comprensión lectora · Uso de la lengua",
    className: "subject-card subject-card--english",
    href: "/ingles/",
  },
  {
    key: "02",
    symbol: "french",
    title: "Francés",
    description:
      "Comprensión de textos y ejercicios de lengua resueltos y explicados respuesta a respuesta.",
    detail: "Comprensión lectora · Uso de la lengua",
    className: "subject-card subject-card--french",
    href: "/frances/",
  },
  {
    key: "03",
    symbol: "atom",
    title: "Física",
    description:
      "Problemas razonados paso a paso, con fórmulas, diagramas y criterios de corrección.",
    detail: "Mecánica · Campos · Ondas · Óptica",
    className: "subject-card subject-card--physics",
    href: "/fisica/",
  },
  {
    key: "04",
    symbol: "graph",
    title: "Matemáticas aplicadas",
    description:
      "Resoluciones claras de cada ejercicio, desde el planteamiento hasta el resultado final.",
    detail: "Álgebra · Análisis · Probabilidad",
    className: "subject-card subject-card--math",
    href: "/matematicas-aplicadas/",
  },
] as const

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Selectividad resuelta",
  url: Astro.site?.href,
  inLanguage: "es",
  description:
    "Exámenes de Selectividad (PEvAU) de Andalucía resueltos paso a paso: Inglés, Francés, Física y Matemáticas aplicadas.",
}
---

<Base
  title="Selectividad resuelta · Exámenes de la PEvAU de Andalucía resueltos"
  description="Exámenes de Selectividad (PEvAU) de Andalucía resueltos paso a paso: Inglés, Francés, Física y Matemáticas aplicadas a las CCSS, de 2021 a 2026."
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="eyebrow">
          <span class="eyebrow-dot"></span>
          PEvAU · Andalucía
        </div>
        <h1>
          Entender el examen.
          <br />
          <em>Resolverlo bien.</em>
        </h1>
        <p class="hero-lead">
          Exámenes de Selectividad de Andalucía resueltos con rigor, claridad y todo el
          razonamiento que necesitas para preparar la prueba.
        </p>
        <div class="hero-actions">
          <a href="#asignaturas" class="button button--primary">
            Explorar exámenes
            <Icon name="arrow-up-right" />
          </a>
          <a href="#metodo" class="text-link">
            Conoce nuestro método
            <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>

      <div class="hero-visual" aria-label="Ejemplo de resolución de un examen">
        <div class="formula-orbit formula-orbit--one">✓</div>
        <div class="paper-card paper-card--real">
          <img
            src="/examen-selectividad-andalucia.png"
            alt="Examen oficial de Selectividad de Andalucía"
          />
        </div>
      </div>
    </div>
    <div class="container hero-foot">
      <span>Exámenes oficiales</span>
      <span>Resoluciones revisadas</span>
      <span>Acceso libre</span>
    </div>
  </section>

  <section class="subjects section" id="asignaturas">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="section-index">01</span>
          <p class="section-kicker">Elige tu asignatura</p>
        </div>
        <h2>
          Cuatro materias.
          <br />
          <em>Un objetivo claro.</em>
        </h2>
        <p>
          Empieza por la asignatura que quieres preparar y avanza a tu ritmo con resoluciones
          completas.
        </p>
      </div>
      <div class="subject-grid">
        {
          subjects.map((subject) => (
            <a href={subject.href} class={subject.className}>
              <div class="subject-top">
                <span class="subject-number">{subject.key}</span>
                <span class="subject-arrow">
                  <Icon name="arrow-up-right" />
                </span>
              </div>
              <div class="subject-symbol" aria-hidden="true">
                <SubjectSymbol type={subject.symbol} />
              </div>
              <div class="subject-content">
                <h3>{subject.title}</h3>
                <p>{subject.description}</p>
                <span class="subject-detail">{subject.detail}</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="method section" id="metodo">
    <div class="container method-grid">
      <div class="method-intro">
        <span class="section-index section-index--light">02</span>
        <p class="section-kicker section-kicker--light">Una forma mejor de estudiar</p>
        <h2>
          No memorices
          <br />
          la solución.
          <br />
          <em>Compréndela.</em>
        </h2>
      </div>
      <div class="method-list">
        <article>
          <span>01</span>
          <div>
            <h3>Enunciado original</h3>
            <p>Cada ejercicio conserva el contexto y la estructura del examen oficial.</p>
          </div>
        </article>
        <article>
          <span>02</span>
          <div>
            <h3>Razonamiento visible</h3>
            <p>
              Explicamos qué fórmula usar, por qué y cómo llegar al resultado sin atajos.
            </p>
          </div>
        </article>
        <article>
          <span>03</span>
          <div>
            <h3>Respuesta de examen</h3>
            <p>
              Una solución ordenada, rigurosa y fácil de reproducir el día de la prueba.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="exams section" id="convocatorias">
    <div class="container exams-grid">
      <div class="exam-copy">
        <span class="section-index">03</span>
        <p class="section-kicker">Archivo por convocatorias</p>
        <h2>
          Practica con
          <br />
          <em>exámenes reales.</em>
        </h2>
        <p>
          Consulta las pruebas organizadas por asignatura, año y convocatoria. Un archivo que
          crecerá contigo.
        </p>
        <a href="#asignaturas" class="button button--dark">
          Elegir asignatura
          <Icon name="arrow-up-right" />
        </a>
      </div>
      <div class="year-stack" aria-label="Convocatorias disponibles">
        {
          ["2025", "2024", "2023"].map((year, index) => (
            <div class="year-row">
              <span class="year-status">{index === 0 ? "Última" : "Archivo"}</span>
              <strong>{year}</strong>
              <div class="year-meta">
                <span>Ordinaria</span>
                <span>Extraordinaria</span>
              </div>
              <Icon name="arrow-up-right" />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="closing">
    <div class="container closing-inner">
      <Icon name="book-open" />
      <p>Preparar bien un examen empieza por <em>entenderlo de verdad.</em></p>
      <a href="#asignaturas" class="circle-link" aria-label="Ver asignaturas">
        <Icon name="arrow-up-right" />
      </a>
    </div>
  </section>
</Base>
