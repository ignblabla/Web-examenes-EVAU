---
import "katex/dist/katex.min.css"
import { getCollection, render, type CollectionEntry } from "astro:content"
import BotonPdf from "../../../components/BotonPdf.astro"
import EnlacesRelacionados, { type Enlace } from "../../../components/EnlacesRelacionados.astro"
import Icon from "../../../components/Icon.astro"
import PieImpresion from "../../../components/PieImpresion.astro"
import Bloque from "../../../components/oficial/Bloque.astro"
import Cabecera from "../../../components/oficial/Cabecera.astro"
import Datos from "../../../components/oficial/Datos.astro"
import Ecuacion from "../../../components/oficial/Ecuacion.astro"
import Ejercicio from "../../../components/oficial/Ejercicio.astro"
import Nuclido from "../../../components/oficial/Nuclido.astro"
import Resuelto from "../../../components/oficial/Resuelto.astro"
import { buscarAsignatura, nombreSeo, nombresSeo, otraLengua } from "../../../data/asignaturas"
import { cabeceras } from "../../../data/cabeceras"
import {
  convocatoriaSeo,
  cursos,
  examenesDe,
  nombreExamen,
  prueba,
  rutaAnio,
  rutaCurso,
  rutaExamen,
  rutaTema,
  tipoLargo,
} from "../../../data/examenes"
import { fechaLarga, fechasDe } from "../../../data/fechas"
import { orientacionesDe, rutaOrientaciones } from "../../../data/orientaciones"
import { autor, editor, migas, persona, referenciaAutor, referenciaEditor } from "../../../data/sitio"
import Base from "../../../layouts/Base.astro"

export async function getStaticPaths() {
  const examenes = await getCollection("examenes")
  return examenes.map((entrada) => ({
    params: {
      asignatura: entrada.data.asignatura,
      anio: String(entrada.data.anio),
      examen: entrada.data.convocatoria,
    },
    props: { entrada },
  }))
}

interface Props {
  entrada: CollectionEntry<"examenes">
}

const { entrada } = Astro.props
const { anio, convocatoria } = entrada.data
const asignatura = buscarAsignatura(entrada.data.asignatura)
const { slug } = asignatura
const { Content } = await render(entrada)

const curso = cursos.find((c) => c.anio === anio)
const examen = curso && examenesDe(curso).find((e) => e.slug === convocatoria)
if (!curso || !examen) throw new Error(`Convocatoria desconocida: ${entrada.id}`)
const cabecera = cabeceras[entrada.id]
const nombre = nombreExamen(anio, examen)

// Partes resueltas de este examen (una por tema) y resto de exámenes publicados.
const ejercicios = (await getCollection("ejercicios")).filter(
  (e) =>
    e.data.asignatura === slug && e.data.anio === anio && e.data.convocatoria === convocatoria,
)
const resuelto = ejercicios.length > 0
const temasResueltos = asignatura.temas.filter((t) => ejercicios.some((e) => e.data.tema === t.slug))
// "A, B y C", con "e" en vez de "y" si el último empieza por i- o hi- (Inferencia estadística).
const nombresResueltos = temasResueltos.map((t) => t.termino ?? t.titulo)
const ultimoResuelto = nombresResueltos.at(-1) ?? ""
const bloquesResueltos =
  nombresResueltos.length > 1
    ? `${nombresResueltos.slice(0, -1).join(", ")} ${/^h?i(?![aeiouáéíóú])/i.test(ultimoResuelto) ? "e" : "y"} ${ultimoResuelto}`
    : ultimoResuelto
const publicados = new Set((await getCollection("examenes")).map((e) => e.id))
const publicado = (asig: string, a: number, conv: string) => publicados.has(`${asig}/${a}/${conv}`)

// Las mismas fechas que el <lastmod> del sitemap: salen de la ruta de la página.
const { publicado: fechaPublicacion, modificado } = fechasDe(rutaExamen(slug, anio, examen))!

// El title más completo que quepa en 60 caracteres, con la prueba de ese curso (PEvAU o PAU).
// "Julio (extraordinaria)" no cabe junto a "Andalucía": se prefiere conservar Andalucía. Si
// tampoco cabe así, primero se quita "Examen" y después se abrevia la asignatura (Mates CCSS).
const corto = nombreSeo(asignatura)
const convocatoriaLarga = convocatoriaSeo(examen)
const convocatoriaCorta = examen.titulo.toLowerCase()
const fin = resuelto ? " resuelto" : ""
const opciones = [
  ...nombresSeo(asignatura).flatMap((n) =>
    ["Examen ", ""].flatMap((examenDe) => [
      `${examenDe}${n} ${prueba(anio)} Andalucía ${anio} ${convocatoriaLarga}${fin}`,
      `${examenDe}${n} ${prueba(anio)} Andalucía ${anio} ${convocatoriaCorta}${fin}`,
    ]),
  ),
  `Examen ${corto} ${prueba(anio)} ${anio} ${convocatoriaCorta}${fin}`,
]
const titulo = opciones.find((t) => t.length <= 60) ?? opciones.at(-1)!
// La descripción más completa que quepa en 155 caracteres. Hasta 2024 la prueba era la PEvAU.
const pruebaSeo = prueba(anio) === "PAU" ? "PAU, antes PEvAU" : "PEvAU"
const inicioDescripcion = `Examen de ${corto} de Selectividad (${pruebaSeo}) de Andalucía, ${convocatoriaLarga} de ${anio},`
const descripciones = resuelto
  ? [
      ...(asignatura.soluciones
        ? [`${inicioDescripcion} resuelto paso a paso, con soluciones ${asignatura.soluciones}.`]
        : []),
      `${inicioDescripcion} resuelto paso a paso, con soluciones explicadas.`,
      `${inicioDescripcion} resuelto paso a paso y con soluciones.`,
    ]
  : [
      `Enunciado oficial del examen de ${corto} de Selectividad (${pruebaSeo}) de Andalucía de ${nombre}: ${tipoLargo(examen.tipo).toLowerCase()} del curso ${curso.curso}.`,
    ]
const descripcion =
  entrada.data.descripcion ?? descripciones.find((d) => d.length <= 155) ?? descripciones.at(-1)!
const url = new URL(Astro.url.pathname, Astro.site).href
// Primer párrafo: el nombre de la prueba ese curso y los demás con los que se busca.
const presentacion =
  prueba(anio) === "PAU"
    ? "PAU de Andalucía (antes PEvAU, también conocida como EBAU o Selectividad)"
    : "PEvAU de Andalucía (hoy PAU, también conocida como EBAU o Selectividad)"

// Enlaces: anterior y siguiente en orden cronológico, la otra lengua, el año y los temas.
const secuencia = [...cursos]
  .reverse()
  .flatMap((c) => examenesDe(c).map((e) => ({ anio: c.anio, examen: e })))
  .filter((s) => publicado(slug, s.anio, s.examen.slug))
const posicion = secuencia.findIndex((s) => s.anio === anio && s.examen.slug === convocatoria)
const otra = otraLengua(asignatura)
const enlaces: Enlace[] = []
const anterior = secuencia[posicion - 1]
const siguiente = secuencia[posicion + 1]
if (anterior)
  enlaces.push({
    etiqueta: "Examen anterior",
    texto: `${asignatura.nombre}, ${nombreExamen(anterior.anio, anterior.examen)}`,
    href: rutaExamen(slug, anterior.anio, anterior.examen),
  })
if (siguiente)
  enlaces.push({
    etiqueta: "Examen siguiente",
    texto: `${asignatura.nombre}, ${nombreExamen(siguiente.anio, siguiente.examen)}`,
    href: rutaExamen(slug, siguiente.anio, siguiente.examen),
  })
if (otra && publicado(otra.slug, anio, convocatoria))
  enlaces.push({
    etiqueta: `Misma convocatoria en ${otra.nombre}`,
    texto: `Examen de ${otra.nombre} de ${nombre} resuelto`,
    href: rutaExamen(otra.slug, anio, examen),
  })
for (const tema of temasResueltos)
  enlaces.push({
    etiqueta: "Practicar por temas",
    texto: `${tema.termino ?? tema.titulo} de ${asignatura.nombre}: los exámenes de ${anio}`,
    href: rutaTema(slug, tema, anio),
  })
enlaces.push({
  etiqueta: `Curso ${curso.curso}`,
  texto: `Todos los exámenes de ${asignatura.nombre} de ${anio}`,
  href: rutaAnio(slug, anio),
})
enlaces.push({
  etiqueta: `Selectividad ${anio}`,
  texto: `Exámenes de ${anio} de todas las asignaturas (${prueba(anio)})`,
  href: rutaCurso(anio),
})
// Las orientaciones son las del próximo examen, no las del curso de este examen.
const orientaciones = orientacionesDe(slug)
if (orientaciones)
  enlaces.push({
    etiqueta: "Orientaciones oficiales",
    texto: `Orientaciones de ${asignatura.nombre} para la PAU ${orientaciones.anio}: qué entra y cómo se corrige`,
    href: rutaOrientaciones(slug),
  })

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    editor(Astro.site),
    persona(Astro.site),
    {
      "@type": ["Article", "LearningResource"],
      "@id": `${url}#examen`,
      headline: titulo,
      name: titulo,
      description: descripcion,
      url,
      mainEntityOfPage: url,
      image: new URL(`/og/${slug}.png`, Astro.site).href,
      inLanguage: asignatura.idioma ? ["es", asignatura.idioma] : "es",
      datePublished: fechaPublicacion,
      dateModified: modificado,
      author: referenciaAutor(Astro.site),
      publisher: referenciaEditor(Astro.site),
      isAccessibleForFree: true,
      learningResourceType: resuelto ? "Examen resuelto" : "Examen",
      educationalLevel: "2.º de Bachillerato",
      educationalUse: "Preparación de la Prueba de Acceso a la Universidad (Selectividad)",
      about: [
        { "@type": "Thing", name: asignatura.nombre },
        {
          "@type": "Thing",
          name: `Prueba de Acceso a la Universidad (${prueba(anio)}) de Andalucía`,
        },
      ],
      ...(resuelto && { teaches: temasResueltos.map((t) => t.termino ?? t.titulo) }),
      isPartOf: { "@type": "CollectionPage", url: new URL(rutaAnio(slug, anio), Astro.site).href },
    },
    migas(Astro.site, [
      { nombre: asignatura.nombre, ruta: `/${slug}/` },
      { nombre: String(anio), ruta: rutaAnio(slug, anio) },
      { nombre: examen.titulo, ruta: Astro.url.pathname },
    ]),
  ],
}
---

<Base
  title={titulo}
  description={descripcion}
  jsonLd={jsonLd}
  image={`/og/${slug}.png`}
  type="article"
  modified={modificado}
  noindex={!asignatura.indexable}
>
  <PieImpresion slot="head" url={url} />
  <section class="hero exam-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Ruta">
        <a href="/">Inicio</a>
        <span aria-hidden="true">/</span>
        <a href={`/${slug}/`}>{asignatura.nombre}</a>
        <span aria-hidden="true">/</span>
        <a href={rutaAnio(slug, anio)}>{anio}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{examen.titulo}</span>
      </nav>
      <div class="eyebrow">
        <span class="eyebrow-dot"></span>
        {tipoLargo(examen.tipo)} · Curso {curso.curso}
      </div>
      <h1>
        {asignatura.nombre}, {nombre}.
        <br />
        <em>Examen de Selectividad{resuelto && " resuelto"}.</em>
      </h1>
      <p class="hero-lead">
        {
          resuelto
            ? `Este es el examen oficial de ${examen.tipo === "reserva" ? "la " : ""}${nombre} de la ${presentacion}, corregido y con las soluciones de ${bloquesResueltos} explicadas pregunta a pregunta. Intenta cada ejercicio antes de mirar su solución.`
            : `Este es el examen oficial de ${examen.tipo === "reserva" ? "la " : ""}${nombre} de la ${presentacion}. Las soluciones aún no están publicadas.`
        }
      </p>
      <div class="exam-meta">
        <p class="exam-updated">
          {resuelto && <>Resuelto por <a href={autor.ruta}>{autor.nombre}</a> · </>}
          Revisado el <time datetime={modificado}>{fechaLarga(modificado)}</time>
        </p>
        <BotonPdf asignatura={slug} anio={anio} convocatoria={convocatoria} />
      </div>
    </div>
  </section>

  <section class="exam-body">
    <div class="container">
      <article class="exam-sheet">
        {cabecera && <Cabecera cabecera={cabecera} />}
        <div
          class={`official-statement official-statement--${entrada.data.formato}`}
          lang={asignatura.idioma}
        >
          <Content components={{ Bloque, Datos, Ecuacion, Ejercicio, Nuclido, Resuelto }} />
        </div>
      </article>

      <EnlacesRelacionados id="sigue-practicando" titulo="Sigue practicando" enlaces={enlaces} />

      <a href={`/${slug}/#examenes`} class="button button--dark exam-back">
        Volver a los exámenes de {asignatura.nombre}
        <Icon name="arrow-up-right" />
      </a>
    </div>
  </section>

  <script>
    // Al imprimir salen todas las soluciones, también las plegadas.
    window.addEventListener("beforeprint", () => {
      for (const solucion of document.querySelectorAll<HTMLDetailsElement>(".solution--plegable"))
        solucion.open = true
    })
  </script>
</Base>
