---
import "katex/dist/katex.min.css"
import { getCollection, render, type CollectionEntry } from "astro:content"
import Icon from "../../../components/Icon.astro"
import Cabecera from "../../../components/oficial/Cabecera.astro"
import Datos from "../../../components/oficial/Datos.astro"
import Ecuacion from "../../../components/oficial/Ecuacion.astro"
import Ejercicio from "../../../components/oficial/Ejercicio.astro"
import Nuclido from "../../../components/oficial/Nuclido.astro"
import { buscarAsignatura } from "../../../data/asignaturas"
import { cabeceras } from "../../../data/cabeceras"
import { cursos } from "../../../data/examenes"
import Base from "../../../layouts/Base.astro"

export async function getStaticPaths() {
  const examenes = await getCollection("examenes")
  return examenes.map((entrada) => ({
    params: {
      asignatura: entrada.data.asignatura,
      anio: String(entrada.data.anio),
      examen: entrada.data.convocatoria,
    },
    props: { entrada },
  }))
}

interface Props {
  entrada: CollectionEntry<"examenes">
}

const { entrada } = Astro.props
const { anio, convocatoria } = entrada.data
const asignatura = buscarAsignatura(entrada.data.asignatura)
const { Content } = await render(entrada)

const curso = cursos.find((c) => c.anio === anio)
const examen = [...(curso?.oficiales ?? []), ...(curso?.reservas ?? [])].find(
  (e) => e.slug === convocatoria,
)
const nombre = examen?.titulo ?? convocatoria
const tipo =
  examen?.tipo === "ordinaria"
    ? "Convocatoria ordinaria"
    : examen?.tipo === "extraordinaria"
      ? "Convocatoria extraordinaria"
      : "Examen de reserva"
const cabecera = cabeceras[entrada.id]

const titulo = `Examen de ${asignatura.nombre} ${nombre.toLowerCase()} ${anio} resuelto · PEvAU Andalucía`
const descripcion =
  entrada.data.descripcion ??
  `Enunciado y solución paso a paso del examen de ${asignatura.nombre} de la PEvAU de Andalucía, ${tipo.toLowerCase()} de ${nombre.toLowerCase()} de ${anio} (curso ${curso?.curso ?? anio}).`
const url = new URL(Astro.url.pathname, Astro.site).href

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "LearningResource",
    name: `Examen de ${asignatura.nombre} ${nombre} ${anio} · PEvAU Andalucía`,
    description: descripcion,
    url,
    inLanguage: "es",
    learningResourceType: "Examen resuelto",
    educationalLevel: "2.º de Bachillerato",
    about: asignatura.nombre,
    isAccessibleForFree: true,
    educationalUse: "Preparación de la Prueba de Acceso a la Universidad (PEvAU)",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: Astro.site?.href },
      {
        "@type": "ListItem",
        position: 2,
        name: asignatura.nombre,
        item: new URL(`/${asignatura.slug}/`, Astro.site).href,
      },
      { "@type": "ListItem", position: 3, name: `${nombre} ${anio}`, item: url },
    ],
  },
]
---

<Base title={titulo} description={descripcion} jsonLd={jsonLd}>
  <section class="hero exam-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Ruta">
        <a href="/">Inicio</a>
        <span aria-hidden="true">/</span>
        <a href={`/${asignatura.slug}/`}>{asignatura.nombre}</a>
        <span aria-hidden="true">/</span>
        <a href={`/${asignatura.slug}/#examenes`}>{anio}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{nombre}</span>
      </nav>
      <div class="eyebrow">
        <span class="eyebrow-dot"></span>
        {asignatura.nombre} · Curso {curso?.curso ?? anio}
      </div>
      <h1>
        {nombre} {anio}.
        <br />
        <em>{tipo}.</em>
      </h1>
    </div>
  </section>

  <section class="exam-body">
    <div class="container">
      <article class="exam-sheet">
        {cabecera && <Cabecera cabecera={cabecera} />}
        <div class={`official-statement official-statement--${entrada.data.formato}`}>
          <Content components={{ Datos, Ecuacion, Ejercicio, Nuclido }} />
        </div>
      </article>

      <a href={`/${asignatura.slug}/#examenes`} class="button button--dark exam-back">
        Volver a los exámenes de {asignatura.nombre}
        <Icon name="arrow-up-right" />
      </a>
    </div>
  </section>
</Base>
