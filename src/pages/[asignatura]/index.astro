---
import { getCollection } from "astro:content"
import Icon from "../../components/Icon.astro"
import ResumenAsignatura from "../../components/ResumenAsignatura.astro"
import SubjectSymbol from "../../components/SubjectSymbol.astro"
import { asignaturas, cursoDe, nombreSeo, type Asignatura } from "../../data/asignaturas"
import {
  cursos,
  examenesDe,
  primerAnio,
  prueba,
  rutaAnio,
  rutaAnteriores,
  rutaCurso,
  rutaExamen,
  rutaExtraordinaria,
  rutaTema,
  rutaTemaGeneral,
  ultimoAnio,
  type Examen,
} from "../../data/examenes"
import { orientacionesDe, rutaOrientaciones } from "../../data/orientaciones"
import { editor, migas, referenciaWeb } from "../../data/sitio"
import Base from "../../layouts/Base.astro"

export function getStaticPaths() {
  return asignaturas.map((asignatura) => ({
    params: { asignatura: asignatura.slug },
    props: { asignatura },
  }))
}

interface Props {
  asignatura: Asignatura
}

const { asignatura } = Astro.props
const { slug, temas } = asignatura
// Orientaciones oficiales del próximo curso, si ya tienen página.
const orientaciones = orientacionesDe(slug)

// Cursos de la asignatura: desde su primer año con exámenes hasta el último.
const desde = asignatura.desde ?? primerAnio
// Cada curso, con solo los exámenes de reserva que existen en la asignatura.
const cursosAsignatura = cursos.filter((c) => c.anio >= desde).map((c) => cursoDe(asignatura, c))
const totalExamenes = cursosAsignatura.reduce((n, c) => n + examenesDe(c).length, 0)

// Solo se enlazan los exámenes que ya están publicados; el resto se muestran sin enlace.
const publicados = new Set((await getCollection("examenes")).map((e) => e.id))
const publicado = (anio: number, e: Examen) => publicados.has(`${slug}/${anio}/${e.slug}`)

// Igual con los temas: un año se enlaza si tiene ejercicios de algún examen.
const temasPublicados = new Set(
  (await getCollection("ejercicios"))
    .filter((e) => e.data.asignatura === slug)
    .map((e) => `${e.data.tema}/${e.data.anio}`),
)

// Cada tema tiene su propio tono: una escala del color de la asignatura que
// va del más intenso (primer tema) al más claro (último), sin repetir ninguno.
const tono = (i: number) =>
  `--mix: ${temas.length > 1 ? 100 - (i * 100) / (temas.length - 1) : 100}%`

// La tarjeta final ocupa los huecos que dejan los temas en la última fila.
const ctaSpan = `--cta-span-3: ${3 - (temas.length % 3)}; --cta-span-2: ${2 - (temas.length % 2)}`

// Si en algún curso no están las cuatro reservas, los textos no prometen cuatro.
const reservasPorCurso = new Set(cursosAsignatura.map((c) => c.reservas.length))
const cuatroReservas = reservasPorCurso.size === 1 && reservasPorCurso.has(4)
// Si no, el panel da el total de reservas disponibles (en Física: solo la reserva 1 de 2026).
const totalReservas = cursosAsignatura.reduce((n, c) => n + c.reservas.length, 0)
const reservasPanel = cuatroReservas
  ? "4 exámenes"
  : `${totalReservas} ${totalReservas === 1 ? "examen" : "exámenes"}`

const filas = [
  { titulo: "Exámenes oficiales", nota: "Ordinaria y extraordinaria", campo: "oficiales" },
  {
    titulo: "Exámenes de reserva",
    nota: cuatroReservas ? "Cuatro modelos por curso" : "Los modelos disponibles",
    campo: "reservas",
  },
] as const

// El title más completo que quepa en 60 caracteres.
const corto = nombreSeo(asignatura)
// La primera opción no cabe con los nombres actuales; queda por si se acorta alguno.
const opciones = [
  `Exámenes ${corto} Selectividad Andalucía resueltos (PAU y PEvAU)`,
  `Exámenes ${corto} Selectividad Andalucía resueltos (PAU)`,
  `Exámenes ${corto} Selectividad Andalucía resueltos`,
]
const titulo = opciones.find((t) => t.length <= 60) ?? opciones.at(-1)!
const pruebas = prueba(desde) === "PAU" ? "PAU" : "PAU y PEvAU"
// "de 2021 a 2026", o "de 2026" si la asignatura solo tiene exámenes del último curso.
const periodo = desde === ultimoAnio ? `de ${desde}` : `de ${desde} a ${ultimoAnio}`
// La descripción más completa que quepa en 160 caracteres.
const inicio = `Todos los exámenes de ${corto} de Selectividad de Andalucía (${pruebas}) ${periodo}`
const descripciones = [
  `${inicio}: junio, julio y reservas resueltos paso a paso, con soluciones y por temas.`,
  `${inicio}: junio, julio y reservas, con las soluciones explicadas y por temas.`,
  `${inicio}: junio, julio y reservas, resueltos y por temas.`,
]
const descripcion = descripciones.find((d) => d.length <= 160) ?? descripciones.at(-1)!
const url = new URL(Astro.url.pathname, Astro.site).href

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    editor(Astro.site),
    {
      "@type": "CollectionPage",
      "@id": url,
      name: titulo,
      description: descripcion,
      url,
      inLanguage: "es",
      isPartOf: referenciaWeb(Astro.site),
      about: { "@type": "Thing", name: asignatura.nombre },
    },
    migas(Astro.site, [{ nombre: asignatura.nombre, ruta: `/${slug}/` }]),
  ],
}
---

<Base
  title={titulo}
  description={descripcion}
  jsonLd={jsonLd}
  image={`/og/${slug}.png`}
  noindex={!asignatura.indexable}
>
  <section class="hero subject-hero">
    <div class="container subject-hero-grid">
      <div class="hero-copy">
        <nav class="breadcrumb" aria-label="Ruta">
          <a href="/">Inicio</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{asignatura.nombre}</span>
        </nav>
        <div class="eyebrow">
          <span class="eyebrow-dot"></span>
          {asignatura.nombre} · Selectividad Andalucía
        </div>
        <h1>Exámenes resueltos de {asignatura.nombre}</h1>
        <p class="subject-subtitle">
          {`Selectividad de Andalucía (${pruebas}), ${desde === ultimoAnio ? `curso ${desde - 1}-${desde}` : `de ${desde} a ${ultimoAnio}`}`}
        </p>
        <p class="hero-lead">
          {
            asignatura.intro ??
              "Todas las convocatorias de cada curso, la ordinaria, la extraordinaria y los cuatro exámenes de reserva, y los ejercicios agrupados por temas, con su resolución completa."
          }
          {
            orientaciones && (
              <>
                {" "}Todo lo que entra y cómo se corrige, en las{" "}
                <a href={rutaOrientaciones(slug)}>orientaciones del curso {orientaciones.curso}</a>.
              </>
            )
          }
          {" "}Cada examen se puede descargar en PDF.
        </p>
        {
          orientaciones && (
            <a href={rutaOrientaciones(slug)} class="orientaciones-aviso">
              {`Orientaciones ${orientaciones.curso}: cómo será el examen de ${asignatura.nombre}`}
              <Icon name="arrow-up-right" />
            </a>
          )
        }
        <dl class="subject-stats">
          <div>
            <dt>Cursos</dt>
            <dd>{cursosAsignatura.length}</dd>
          </div>
          <div>
            <dt>Exámenes</dt>
            <dd>{totalExamenes}</dd>
          </div>
          <div>
            <dt>Temas</dt>
            <dd>{temas.length}</dd>
          </div>
        </dl>
      </div>

      <aside
        class={`subject-panel subject-panel--${asignatura.color}`}
        aria-label="Convocatorias de cada curso"
      >
        <div class="subject-panel-symbol" aria-hidden="true">
          <SubjectSymbol type={asignatura.simbolo} />
        </div>
        <ul class="subject-panel-list">
          <li>
            <span>Ordinaria</span>
            <strong>Junio</strong>
          </li>
          <li>
            <span>Extraordinaria</span>
            <strong>Julio</strong>
          </li>
          <li>
            <span>Reservas</span>
            <strong>{reservasPanel}</strong>
          </li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section archive" id="examenes">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="section-index">01</span>
          <p class="section-kicker">Archivo por años</p>
        </div>
        <h2>
          Cada convocatoria.
          <br />
          <em>Cada año.</em>
        </h2>
        <p>
          {
            cuatroReservas
              ? "Cada curso tiene una convocatoria ordinaria en junio, una extraordinaria en julio y cuatro exámenes de reserva."
              : "Cada curso tiene una convocatoria ordinaria en junio, una extraordinaria en julio y los exámenes de reserva que se han podido encontrar."
          }
        </p>
      </div>

      <p class="curso-links">
        Todas las asignaturas:
        {cursosAsignatura.map((c) => <a href={rutaCurso(c.anio)}>Selectividad {c.anio}</a>)}
        <a href={rutaExtraordinaria}>Convocatoria extraordinaria</a>
        <a href={rutaAnteriores}>Años anteriores</a>
      </p>

      <div class="archive-columns">
        {
          filas.map((fila) => (
            <article class="archive-panel">
              <header class="archive-panel-head">
                <h3>{fila.titulo}</h3>
                <p>{fila.nota}</p>
              </header>
              <ul class="archive-list">
                {cursosAsignatura.filter((c) => c[fila.campo].length > 0).map((c) => (
                  <li>
                    <strong>
                      {examenesDe(c).some((e) => publicado(c.anio, e)) ? (
                        <a href={rutaAnio(slug, c.anio)}>{c.anio}</a>
                      ) : (
                        c.anio
                      )}
                    </strong>
                    <div class="exam-links">
                      {c[fila.campo].map((e) => {
                        const texto = e.titulo.replace("Reserva ", "Res ")
                        return publicado(c.anio, e) ? (
                          <a
                            href={rutaExamen(slug, c.anio, e)}
                            class={`exam-link exam-link--${e.tipo}`}
                          >
                            {texto}
                          </a>
                        ) : (
                          <span
                            class={`exam-link exam-link--${e.tipo} is-pending`}
                            title="Próximamente"
                          >
                            {texto}
                          </span>
                        )
                      })}
                    </div>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class={`section topics topics--${asignatura.color}`} id="temas">
    <div class="container">
      <div class="topics-heading">
        <div>
          <span class="section-index section-index--light">02</span>
          <p class="section-kicker section-kicker--light">Ejercicios resueltos por temas</p>
        </div>
        <h2>
          Practica un tema.
          <br />
          <em>Año a año.</em>
        </h2>
      </div>

      <div class="topic-grid">
        {
          temas.map((t, i) => (
            <article class="topic-card topic-card--tone" style={tono(i)}>
              <span class="topic-number">Tema {i + 1}</span>
              <h3>
                <a href={rutaTemaGeneral(slug, t)}>{t.titulo}</a>
              </h3>
              <a href={rutaTemaGeneral(slug, t)} class="topic-all">
                Todos los ejercicios
                <Icon name="arrow-up-right" />
              </a>
              <div class="topic-years">
                {cursosAsignatura.map((c) =>
                  temasPublicados.has(`${t.slug}/${c.anio}`) ? (
                    <a href={rutaTema(slug, t, c.anio)} aria-label={`${t.titulo}, ${c.anio}`}>{c.anio}</a>
                  ) : (
                    <span class="is-pending" title="Próximamente">
                      {c.anio}
                    </span>
                  ),
                )}
              </div>
            </article>
          ))
        }
        <a href="#examenes" class="topic-card topic-card--cta" style={ctaSpan}>
          <span class="topic-number">Examen completo</span>
          <h3>¿Prefieres hacerlo entero?</h3>
          <span class="topic-cta-link">
            Ir al archivo por años
            <span class="topic-cta-arrow">
              <Icon name="arrow-up-right" />
            </span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <section class="section subject-notes">
    <div class="container">
      <ResumenAsignatura asignatura={asignatura} />
    </div>
  </section>

  <section class="closing">
    <div class="container closing-inner">
      <Icon name="book-open" />
      <p>¿Preparas otra asignatura? <em>Hay más esperando.</em></p>
      <a href="/#asignaturas" class="circle-link" aria-label="Ver asignaturas">
        <Icon name="arrow-up-right" />
      </a>
    </div>
  </section>
</Base>
