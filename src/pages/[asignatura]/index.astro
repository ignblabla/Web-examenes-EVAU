---
import { getCollection } from "astro:content"
import Icon from "../../components/Icon.astro"
import SubjectSymbol from "../../components/SubjectSymbol.astro"
import { asignaturas, type Asignatura } from "../../data/asignaturas"
import {
  cursos,
  primerAnio,
  rutaExamen,
  totalExamenes,
  ultimoAnio,
  type Examen,
} from "../../data/examenes"
import Base from "../../layouts/Base.astro"

export function getStaticPaths() {
  return asignaturas.map((asignatura) => ({
    params: { asignatura: asignatura.slug },
    props: { asignatura },
  }))
}

interface Props {
  asignatura: Asignatura
}

const { asignatura } = Astro.props
const { slug, temas } = asignatura

// Solo se enlazan los exámenes que ya están publicados; el resto se muestran sin enlace.
const publicados = new Set((await getCollection("examenes")).map((e) => e.id))
const publicado = (anio: number, e: Examen) => publicados.has(`${slug}/${anio}/${e.slug}`)

// Cada tema tiene su propio tono: una escala del color de la asignatura que
// va del más intenso (primer tema) al más claro (último), sin repetir ninguno.
const tono = (i: number) =>
  `--mix: ${temas.length > 1 ? 100 - (i * 100) / (temas.length - 1) : 100}%`

// La tarjeta final ocupa los huecos que dejan los temas en la última fila.
const ctaSpan = `--cta-span-3: ${3 - (temas.length % 3)}; --cta-span-2: ${2 - (temas.length % 2)}`

const filas = [
  { titulo: "Exámenes oficiales", nota: "Ordinaria y extraordinaria", campo: "oficiales" },
  { titulo: "Exámenes de reserva", nota: "Cuatro modelos por curso", campo: "reservas" },
] as const

const titulo = `Exámenes de ${asignatura.nombre} resueltos · PEvAU Andalucía ${primerAnio}–${ultimoAnio}`
const descripcion = `Exámenes de ${asignatura.nombre} de la PEvAU de Andalucía de ${primerAnio} a ${ultimoAnio}: convocatoria ordinaria, extraordinaria y reservas, resueltos paso a paso y organizados por temas.`

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: titulo,
    description: descripcion,
    inLanguage: "es",
    about: asignatura.nombre,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: Astro.site?.href },
      {
        "@type": "ListItem",
        position: 2,
        name: asignatura.nombre,
        item: new URL(`/${slug}/`, Astro.site).href,
      },
    ],
  },
]
---

<Base title={titulo} description={descripcion} jsonLd={jsonLd}>
  <section class="hero subject-hero">
    <div class="container subject-hero-grid">
      <div class="hero-copy">
        <nav class="breadcrumb" aria-label="Ruta">
          <a href="/">Inicio</a>
          <span aria-hidden="true">/</span>
          <a href="/#asignaturas">Asignaturas</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{asignatura.nombre}</span>
        </nav>
        <div class="eyebrow">
          <span class="eyebrow-dot"></span>
          {asignatura.nombre} · PEvAU Andalucía
        </div>
        <h1>
          {asignatura.titulo}
          <br />
          <em>De {primerAnio} a {ultimoAnio}.</em>
        </h1>
        <p class="hero-lead">
          Todas las convocatorias de cada curso, la ordinaria, la extraordinaria y los cuatro
          exámenes de reserva, y los ejercicios agrupados por temas, con su resolución completa.
        </p>
        <dl class="subject-stats">
          <div>
            <dt>Cursos</dt>
            <dd>{cursos.length}</dd>
          </div>
          <div>
            <dt>Exámenes</dt>
            <dd>{totalExamenes}</dd>
          </div>
          <div>
            <dt>Temas</dt>
            <dd>{temas.length}</dd>
          </div>
        </dl>
      </div>

      <aside
        class={`subject-panel subject-panel--${asignatura.color}`}
        aria-label="Convocatorias de cada curso"
      >
        <div class="subject-panel-symbol" aria-hidden="true">
          <SubjectSymbol type={asignatura.simbolo} />
        </div>
        <ul class="subject-panel-list">
          <li>
            <span>Ordinaria</span>
            <strong>Junio</strong>
          </li>
          <li>
            <span>Extraordinaria</span>
            <strong>Julio</strong>
          </li>
          <li>
            <span>Reservas</span>
            <strong>4 exámenes</strong>
          </li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section archive" id="examenes">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="section-index">01</span>
          <p class="section-kicker">Archivo por años</p>
        </div>
        <h2>
          Cada convocatoria.
          <br />
          <em>Cada año.</em>
        </h2>
        <p>
          Cada curso tiene una convocatoria ordinaria en junio, una extraordinaria en julio y
          cuatro exámenes de reserva.
        </p>
      </div>

      <div class="archive-columns">
        {
          filas.map((fila) => (
            <article class="archive-panel">
              <header class="archive-panel-head">
                <h3>{fila.titulo}</h3>
                <p>{fila.nota}</p>
              </header>
              <ul class="archive-list">
                {cursos.map((c) => (
                  <li>
                    <strong>{c.anio}</strong>
                    <div class="exam-links">
                      {c[fila.campo].map((e) => {
                        const texto = e.titulo.replace("Reserva ", "Res ")
                        return publicado(c.anio, e) ? (
                          <a
                            href={rutaExamen(slug, c.anio, e)}
                            class={`exam-link exam-link--${e.tipo}`}
                          >
                            {texto}
                          </a>
                        ) : (
                          <span
                            class={`exam-link exam-link--${e.tipo} is-pending`}
                            title="Próximamente"
                          >
                            {texto}
                          </span>
                        )
                      })}
                    </div>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class={`section topics topics--${asignatura.color}`} id="temas">
    <div class="container">
      <div class="topics-heading">
        <div>
          <span class="section-index section-index--light">02</span>
          <p class="section-kicker section-kicker--light">Ejercicios resueltos por temas</p>
        </div>
        <h2>
          Practica un tema.
          <br />
          <em>Año a año.</em>
        </h2>
      </div>

      <div class="topic-grid">
        {
          temas.map((t, i) => (
            <article class="topic-card topic-card--tone" style={tono(i)}>
              <span class="topic-number">Tema {i + 1}</span>
              <h3>{t.titulo}</h3>
              <div class="topic-years">
                {cursos.map((c) => (
                  <span class="is-pending" title="Próximamente">
                    {c.anio}
                  </span>
                ))}
              </div>
            </article>
          ))
        }
        <a href="#examenes" class="topic-card topic-card--cta" style={ctaSpan}>
          <span class="topic-number">Examen completo</span>
          <h3>¿Prefieres hacerlo entero?</h3>
          <span class="topic-cta-link">
            Ir al archivo por años
            <span class="topic-cta-arrow">
              <Icon name="arrow-up-right" />
            </span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <section class="closing">
    <div class="container closing-inner">
      <Icon name="book-open" />
      <p>¿Preparas otra asignatura? <em>Hay más esperando.</em></p>
      <a href="/#asignaturas" class="circle-link" aria-label="Ver asignaturas">
        <Icon name="arrow-up-right" />
      </a>
    </div>
  </section>
</Base>
