---
import "katex/dist/katex.min.css"
import { getCollection, render } from "astro:content"
import BotonPdf from "../../../../components/BotonPdf.astro"
import EnlacesRelacionados, { type Enlace } from "../../../../components/EnlacesRelacionados.astro"
import Icon from "../../../../components/Icon.astro"
import PieImpresion from "../../../../components/PieImpresion.astro"
import BloqueTema from "../../../../components/oficial/BloqueTema.astro"
import Datos from "../../../../components/oficial/Datos.astro"
import Ecuacion from "../../../../components/oficial/Ecuacion.astro"
import Ejercicio from "../../../../components/oficial/Ejercicio.astro"
import Nuclido from "../../../../components/oficial/Nuclido.astro"
import Solucion from "../../../../components/Solucion.astro"
import { buscarAsignatura, nombreSeo, nombresSeo } from "../../../../data/asignaturas"
import {
  cursos,
  examenesDe,
  nombreCompleto,
  nombreEnFrase,
  nombreTema,
  prueba,
  rutaExamen,
  rutaTema,
  rutaTemaGeneral,
  tipoLargo,
} from "../../../../data/examenes"
import { fechaLarga, fechasDe } from "../../../../data/fechas"
import { orientacionesDe, rutaOrientaciones } from "../../../../data/orientaciones"
import { autor, editor, migas, persona, referenciaAutor, referenciaEditor } from "../../../../data/sitio"
import Base from "../../../../layouts/Base.astro"

// Una página por asignatura, tema y año con los ejercicios de todos los exámenes de ese curso.
export async function getStaticPaths() {
  const ejercicios = await getCollection("ejercicios")
  const claves = new Set(
    ejercicios.map((e) => `${e.data.asignatura}/${e.data.tema}/${e.data.anio}`),
  )
  return [...claves].map((clave) => {
    const [asignatura, tema, anio] = clave.split("/")
    return { params: { asignatura, tema, anio } }
  })
}

const { asignatura: slug, tema: temaSlug, anio: anioTexto } = Astro.params
const anio = Number(anioTexto)
const asignatura = buscarAsignatura(slug)
const tema = asignatura.temas.find((t) => t.slug === temaSlug)
if (!tema) throw new Error(`Tema desconocido: ${slug}/${temaSlug}`)

const curso = cursos.find((c) => c.anio === anio)
const examenes = curso ? examenesDe(curso) : []

// Los ejercicios se ordenan como las convocatorias: junio, julio y las reservas, y dentro de
// cada examen, por partes (cuando los apartados del tema no van seguidos en el examen).
const archivos = (await getCollection("ejercicios"))
  .filter((e) => e.data.asignatura === slug && e.data.tema === temaSlug && e.data.anio === anio)
  .sort((a, b) => (a.data.parte ?? 1) - (b.data.parte ?? 1))
const entradas = [...new Set(archivos.map((e) => e.data.convocatoria))]
  .map((convocatoria) => {
    const partes = archivos.filter((e) => e.data.convocatoria === convocatoria)
    return {
      entrada: partes[0],
      partes,
      orden: examenes.findIndex((e) => e.slug === convocatoria),
      examen: examenes.find((e) => e.slug === convocatoria),
    }
  })
  .sort((a, b) => a.orden - b.orden)

const examenesPublicados = new Set((await getCollection("examenes")).map((e) => e.id))

const secciones = await Promise.all(
  entradas.map(async ({ entrada, partes, examen }) => {
    const contenidos = await Promise.all(partes.map(async (p) => (await render(p)).Content))
    const nombre = examen?.titulo ?? entrada.data.convocatoria
    const tipo = examen ? tipoLargo(examen.tipo) : ""
    const enlace =
      examen && examenesPublicados.has(`${slug}/${anio}/${examen.slug}`)
        ? rutaExamen(slug, anio, examen)
        : undefined
    return { entrada, contenidos, nombre, tipo, enlace }
  }),
)

const termino = nombreTema(tema)
// Las mismas fechas que el <lastmod> del sitemap: salen de la ruta de la página.
const { publicado, modificado } = fechasDe(rutaTema(slug, tema, anio))!

// El title más completo que quepa en 60 caracteres, siempre con "Andalucía" (como en los
// exámenes): primero se quitan las palabras de relleno ("ejercicios resueltos", "con
// soluciones") y solo después se abrevia, primero la asignatura (Mates CCSS) y luego el tema
// (Límites y derivabilidad).
const corto = nombreSeo(asignatura)
const nombres = nombresSeo(asignatura)
const temaCorto = tema.corto ?? termino
const opciones = [
  `${termino} ${corto} ${prueba(anio)} Andalucía ${anio}: ejercicios resueltos`,
  `${termino} ${corto} ${prueba(anio)} Andalucía ${anio} con soluciones`,
  ...nombres.map((n) => `${termino} ${n} ${prueba(anio)} Andalucía ${anio}`),
  ...nombres.map((n) => `${temaCorto} ${n} ${prueba(anio)} Andalucía ${anio}`),
  `${temaCorto} ${nombres.at(-1)} Andalucía ${anio}`,
]
const titulo = opciones.find((t) => t.length <= 60) ?? opciones.at(-1)!
const examenesTexto = entradas.length === 1 ? "del examen" : `de los ${entradas.length} exámenes`
// La descripción más completa que quepa en 160 caracteres.
const inicioDescripcion = `${termino} ${examenesTexto} de ${corto} de Selectividad (${prueba(anio)}) de Andalucía de ${anio}`
const descripciones = [
  `${inicioDescripcion}, con cada respuesta explicada y justificada.`,
  `${inicioDescripcion}, con cada respuesta explicada.`,
]
const descripcion = descripciones.find((d) => d.length <= 160) ?? descripciones.at(-1)!
const url = new URL(Astro.url.pathname, Astro.site).href

// Las orientaciones oficiales del próximo examen: qué entra de este tema y cómo se corrige.
const orientaciones = orientacionesDe(slug)
const antesDelExamen: Enlace[] = orientaciones
  ? [
      {
        etiqueta: "Orientaciones oficiales",
        texto: `Orientaciones de ${asignatura.nombre} para la PAU ${orientaciones.anio}: qué entra y cómo se corrige`,
        href: rutaOrientaciones(slug),
      },
    ]
  : []

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    editor(Astro.site),
    persona(Astro.site),
    {
      "@type": ["Article", "LearningResource"],
      "@id": `${url}#ejercicios`,
      headline: titulo,
      name: titulo,
      description: descripcion,
      url,
      mainEntityOfPage: url,
      image: new URL(`/og/${slug}.png`, Astro.site).href,
      inLanguage: asignatura.idioma ? ["es", asignatura.idioma] : "es",
      datePublished: publicado,
      dateModified: modificado,
      author: referenciaAutor(Astro.site),
      publisher: referenciaEditor(Astro.site),
      isAccessibleForFree: true,
      learningResourceType: "Ejercicios resueltos",
      educationalLevel: "2.º de Bachillerato",
      educationalUse: "Preparación de la Prueba de Acceso a la Universidad (Selectividad)",
      about: [
        { "@type": "Thing", name: asignatura.nombre },
        {
          "@type": "Thing",
          name: `Prueba de Acceso a la Universidad (${prueba(anio)}) de Andalucía`,
        },
      ],
      teaches: termino,
    },
    migas(Astro.site, [
      { nombre: asignatura.nombre, ruta: `/${slug}/` },
      { nombre: tema.titulo, ruta: rutaTemaGeneral(slug, tema) },
      { nombre: String(anio), ruta: Astro.url.pathname },
    ]),
  ],
}
---

<Base
  title={titulo}
  description={descripcion}
  jsonLd={jsonLd}
  image={`/og/${slug}.png`}
  type="article"
  modified={modificado}
  noindex={!asignatura.indexable}
>
  <PieImpresion slot="head" url={url} />
  <section class="hero exam-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Ruta">
        <a href="/">Inicio</a>
        <span aria-hidden="true">/</span>
        <a href={`/${slug}/`}>{asignatura.nombre}</a>
        <span aria-hidden="true">/</span>
        <a href={rutaTemaGeneral(slug, tema)}>{tema.titulo}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{anio}</span>
      </nav>
      <div class="eyebrow">
        <span class="eyebrow-dot"></span>
        {tema.titulo} · Curso {curso?.curso ?? anio}
      </div>
      <a href={rutaTemaGeneral(slug, tema)} class="topic-general-link">
        Todos los ejercicios de {tema.espanol ? termino : nombreEnFrase(tema)}, de todos los años
        <Icon name="arrow-up-right" />
      </a>
      <h1>
        {nombreCompleto(tema)}.
        <br />
        <em>{asignatura.nombre}, exámenes de {anio}.</em>
      </h1>
      {tema.intro && <p class="hero-lead">{tema.intro}</p>}
      <div class="exam-meta">
        <p class="exam-updated">
          Resuelto por <a href={autor.ruta}>{autor.nombre}</a> · Revisado el{" "}
          <time datetime={modificado}>{fechaLarga(modificado)}</time>
        </p>
        <BotonPdf asignatura={slug} anio={anio} convocatoria="todas" tema={temaSlug} />
      </div>
    </div>
  </section>

  <section class="exam-body">
    <div class="container">
      {
        secciones.map(({ entrada, contenidos, nombre, tipo, enlace }) => (
          <details class="topic-exam" id={entrada.data.convocatoria}>
            <summary class="topic-exam-head">
              <div>
                <p class="topic-exam-type">{tipo}</p>
                <h2>
                  {nombre} {anio}
                </h2>
              </div>
              <div class="topic-exam-actions">
                {enlace && (
                  <a href={enlace} class="text-link">
                    Ver el examen completo
                    <Icon name="arrow-up-right" />
                  </a>
                )}
                <span class="topic-exam-toggle" aria-hidden="true">
                  <span class="topic-exam-toggle-open">Ver respuestas</span>
                  <span class="topic-exam-toggle-close">Ocultar respuestas</span>
                </span>
              </div>
            </summary>
            <div class="exam-sheet">
              <div
                class={`official-statement official-statement--${entrada.data.formato}`}
                lang={asignatura.idioma}
              >
                {contenidos.map((Content) => (
                  <Content
                    components={{ Bloque: BloqueTema, Datos, Ecuacion, Ejercicio, Nuclido, Solucion }}
                  />
                ))}
              </div>
            </div>
          </details>
        ))
      }

      <EnlacesRelacionados id="antes-del-examen" titulo="Antes del examen" enlaces={antesDelExamen} />

      <a href={`/${slug}/#temas`} class="button button--dark exam-back">
        Volver a los temas de {asignatura.nombre}
        <Icon name="arrow-up-right" />
      </a>
    </div>
  </section>

  <script>
    // Si se llega con un ancla (#junio, #reserva-1…), se despliega ese examen.
    function abrirAncla() {
      const destino = location.hash && document.getElementById(location.hash.slice(1))
      if (destino instanceof HTMLDetailsElement) destino.open = true
    }
    abrirAncla()
    window.addEventListener("hashchange", abrirAncla)

    // Al imprimir salen todos los exámenes desplegados.
    window.addEventListener("beforeprint", () => {
      for (const examen of document.querySelectorAll<HTMLDetailsElement>(".topic-exam"))
        examen.open = true
    })
  </script>
</Base>
