---
import { getCollection } from "astro:content"
import EnlacesRelacionados, { type Enlace } from "../components/EnlacesRelacionados.astro"
import TablaConvocatorias, { type Fila } from "../components/TablaConvocatorias.astro"
import { asignaturas, cursoDe } from "../data/asignaturas"
import {
  cursos,
  examenesDe,
  nombreExamen,
  prueba,
  rutaAnio,
  rutaAnteriores,
  rutaCurso,
  rutaExamen,
  rutaExtraordinaria,
} from "../data/examenes"
import { fechaLarga, fechasDe } from "../data/fechas"
import { editor, migas, referenciaWeb } from "../data/sitio"
import Base from "../layouts/Base.astro"

// Una página por curso con los exámenes de todas las asignaturas publicadas (indexables).
export async function getStaticPaths() {
  const examenes = await getCollection("examenes")
  return cursos
    .filter((c) => examenes.some((e) => e.data.anio === c.anio))
    .map((c) => ({ params: { anio: String(c.anio) } }))
}

const anio = Number(Astro.params.anio)
const curso = cursos.find((c) => c.anio === anio)!
const nombrePrueba = prueba(anio)

const examenes = await getCollection("examenes")
const publicado = (asig: string, conv: string) => examenes.some((e) => e.id === `${asig}/${anio}/${conv}`)
const ejercicios = (await getCollection("ejercicios")).filter((e) => e.data.anio === anio)
const publicadas = asignaturas.filter(
  (a) => a.indexable && examenes.some((e) => e.data.asignatura === a.slug && e.data.anio === anio),
)
const conSoluciones = ejercicios.length > 0

// Columnas: junio, julio y las cuatro reservas. Las que no existen en una asignatura (las
// reservas 2 a 4 de Física de 2026) salen con "—" y sin enlace.
const convocatorias = examenesDe(curso)
const columnas = convocatorias.map((e) => (e.tipo === "extraordinaria" ? "Julio (extraordinaria)" : e.titulo))
const filas: Fila[] = publicadas.map((a) => ({
  titulo: a.nombre,
  href: rutaAnio(a.slug, anio),
  celdas: convocatorias.map((e) => ({
    texto: e.titulo,
    nombre: `${a.nombre}, ${nombreExamen(anio, e)}`,
    href: publicado(a.slug, e.slug) ? rutaExamen(a.slug, anio, e) : undefined,
  })),
}))

// Asignaturas a las que les falta alguna reserva, para avisarlo en la introducción.
const incompletas = publicadas
  .map((a) => ({ asignatura: a, reservas: cursoDe(a, curso).reservas.filter((e) => publicado(a.slug, e.slug)) }))
  .filter((x) => x.reservas.length < curso.reservas.length)

const nombres = publicadas.map((a) => a.nombre)
const lista = nombres.length > 1 ? `${nombres.slice(0, -1).join(", ")} y ${nombres.at(-1)}` : nombres[0]

// El title más completo que quepa en 60 caracteres, siempre con "Andalucía".
const resueltos = conSoluciones ? " resueltos" : ""
const opciones = [
  `Exámenes Selectividad Andalucía ${anio}${resueltos} (${nombrePrueba})`,
  `Exámenes Selectividad Andalucía ${anio}${resueltos}`,
  `Exámenes ${nombrePrueba} Andalucía ${anio}${resueltos}`,
]
const titulo = opciones.find((t) => t.length <= 60) ?? opciones.at(-1)!
// La descripción más completa que quepa en 160 caracteres.
const soluciones = conSoluciones ? " resueltos" : ""
const descripciones = [
  `Exámenes de Selectividad de Andalucía de ${anio} (${nombrePrueba})${soluciones}: ${lista}. Junio, julio y reservas.`,
  `Exámenes de Selectividad de Andalucía de ${anio} (${nombrePrueba})${soluciones} de todas las asignaturas: junio, julio y reservas.`,
]
const descripcion = descripciones.find((d) => d.length <= 160) ?? descripciones.at(-1)!
const url = new URL(Astro.url.pathname, Astro.site).href

// Año anterior y siguiente con exámenes, y las otras páginas de todas las asignaturas.
const conExamenes = (a: number) => examenes.some((e) => e.data.anio === a)
const otros: Enlace[] = [
  ...(conExamenes(anio + 1)
    ? [{ etiqueta: "Año siguiente", texto: `Exámenes de Selectividad de ${anio + 1} (${prueba(anio + 1)})`, href: rutaCurso(anio + 1) }]
    : []),
  ...(conExamenes(anio - 1)
    ? [{ etiqueta: "Año anterior", texto: `Exámenes de Selectividad de ${anio - 1} (${prueba(anio - 1)})`, href: rutaCurso(anio - 1) }]
    : []),
  { etiqueta: "Convocatoria extraordinaria", texto: "Todos los exámenes de julio, de todos los años", href: rutaExtraordinaria },
  { etiqueta: "Archivo", texto: "Exámenes de años anteriores (PEvAU y PAU)", href: rutaAnteriores },
]

// La fecha del examen revisado más recientemente; la misma que el <lastmod> del sitemap.
const { modificado } = fechasDe(rutaCurso(anio))!

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    editor(Astro.site),
    {
      "@type": "CollectionPage",
      "@id": url,
      name: titulo,
      description: descripcion,
      url,
      inLanguage: "es",
      dateModified: modificado,
      isPartOf: referenciaWeb(Astro.site),
      mainEntity: {
        "@type": "ItemList",
        itemListElement: publicadas.map((a, i) => ({
          "@type": "ListItem",
          position: i + 1,
          name: `Exámenes de ${a.nombre} de ${anio}`,
          url: new URL(rutaAnio(a.slug, anio), Astro.site).href,
        })),
      },
    },
    migas(Astro.site, [{ nombre: `Exámenes ${anio}`, ruta: Astro.url.pathname }]),
  ],
}
---

<Base title={titulo} description={descripcion} jsonLd={jsonLd}>
  <section class="hero exam-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Ruta">
        <a href="/">Inicio</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Exámenes {anio}</span>
      </nav>
      <div class="eyebrow">
        <span class="eyebrow-dot"></span>
        Selectividad ({nombrePrueba}) · Curso {curso.curso}
      </div>
      <h1>
        Selectividad Andalucía {anio}.
        <br />
        <em>Todos los exámenes{conSoluciones && " resueltos"}.</em>
      </h1>
      <p class="hero-lead">
        Los exámenes de la Selectividad de Andalucía de {anio} ({nombrePrueba}) de {lista}: la
        convocatoria ordinaria de junio, la extraordinaria de julio y los exámenes de reserva, con
        el enunciado oficial{conSoluciones && " y las soluciones explicadas"}.
        {anio < 2025 && ` En ${anio} la prueba se llamaba PEvAU; desde 2025 es la PAU.`}
        {
          incompletas.map(({ asignatura, reservas }) =>
            ` De ${asignatura.nombre} de ${anio}, por ahora solo está disponible ${reservas.length === 1 ? `la ${reservas[0].titulo.toLowerCase()}` : `${reservas.length} reservas`}.`,
          )
        }
      </p>
      <p class="exam-updated">
        Actualizado el <time datetime={modificado}>{fechaLarga(modificado)}</time>
      </p>
    </div>
  </section>

  <section class="exam-body">
    <div class="container">
      <section class="curso-section" aria-labelledby="tabla">
        <h2 id="tabla">Exámenes de {anio} por asignatura</h2>
        <TablaConvocatorias
          descripcion={`Exámenes de Selectividad de Andalucía de ${anio} por asignatura y convocatoria`}
          primera="Asignatura"
          columnas={columnas}
          filas={filas}
        />
      </section>

      <EnlacesRelacionados id="otros-anios" titulo="Otros años" enlaces={otros} />
    </div>
  </section>
</Base>
