---
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import { asignaturas } from '../config/asignaturas';
const disponibles = asignaturas.filter((a) => a.disponible);
---
<Base titulo="Página no encontrada | PEvAU Resueltos" descripcion="Esta página no existe." noindex>
  <section class="wrap e404" aria-labelledby="e404-titulo">
    <div class="e404__hoja" aria-hidden="true">
      <span class="e404__fila"><span>Ejercicio</span><b class="num">404</b></span>
      <span class="e404__fila"><span>Puntuación</span><b class="num">0,00</b></span>
      <span class="e404__tachado"></span>
    </div>
    <div>
      <h1 id="e404-titulo" class="display e404__h1">Este ejercicio no entraba en el examen</h1>
      <p class="e404__txt">La página que buscas no existe o ha cambiado de sitio. No cuenta para nota: vuelve al índice y sigue practicando.</p>
      <div class="e404__acciones">
        <a class="btn btn--tinta" href="/">Volver al inicio <Icono nombre="flecha" /></a>
        <a class="btn" href="/buscar/"><Icono nombre="buscar" /> Buscar un ejercicio</a>
        {disponibles.map((a) => <a class="btn btn--sutil" href={`/${a.slug}/`}>{a.nombreCorto}</a>)}
      </div>
    </div>
  </section>
</Base>

<style>
  .e404 { display: grid; gap: var(--s-6); padding-top: var(--s-7); }
  .e404__hoja {
    position: relative; width: min(20rem, 100%); display: grid;
    border: var(--b-form) solid var(--rule-ink); background: var(--paper-2);
    rotate: -2deg; box-shadow: var(--shadow-float);
  }
  .e404__fila { display: flex; justify-content: space-between; align-items: baseline; padding: var(--s-3) var(--s-4); }
  .e404__fila + .e404__fila { border-top: var(--b-hair) solid var(--rule-ink); }
  .e404__fila span { font: 650 var(--t-2xs)/1 var(--f-frame); text-transform: uppercase; letter-spacing: 0.12em; color: var(--ink-3); }
  .e404__fila b { font: 800 var(--t-2xl)/1 var(--f-frame); font-stretch: var(--stretch-display); }
  .e404__tachado { position: absolute; inset: 0; background: linear-gradient(to top right, transparent calc(50% - 1px), var(--alarm) calc(50% - 1px) calc(50% + 1px), transparent calc(50% + 1px)); }
  .e404__h1 { font-size: var(--t-2xl); max-width: 16ch; }
  .e404__txt { margin-top: var(--s-4); color: var(--ink-2); max-width: 50ch; }
  .e404__acciones { display: flex; flex-wrap: wrap; gap: var(--s-2); margin-top: var(--s-5); }
  @media (min-width: 48rem) { .e404 { grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: var(--s-8); padding-top: var(--s-9); } }
</style>
