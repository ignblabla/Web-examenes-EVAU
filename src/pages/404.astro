---
import Icon from "../components/Icon.astro"
import Base from "../layouts/Base.astro"
---

<Base
  title="Página no encontrada · Selectividad resuelta"
  description="La página que buscas no existe o todavía no se ha publicado."
>
  <section class="hero exam-hero">
    <div class="container">
      <div class="eyebrow">
        <span class="eyebrow-dot"></span>
        Error 404
      </div>
      <h1>
        Esta página no existe.
        <br />
        <em>Todavía.</em>
      </h1>
      <p class="hero-lead">
        Puede que el examen que buscas aún no se haya publicado. Vuelve a las asignaturas para ver
        los que ya están disponibles.
      </p>
      <a href="/#asignaturas" class="button button--primary">
        Ver asignaturas
        <Icon name="arrow-up-right" />
      </a>
    </div>
  </section>
</Base>
