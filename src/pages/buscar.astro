---
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import { asignaturas, getAsignatura, nombreBloque, estiloAcento } from '../config/asignaturas';
import { examenes, estructura, urlExamen, nombreConvocatoria } from '../lib/examenes';

// Índice de búsqueda generado al compilar: un registro por ejercicio resuelto.
const todos = (await examenes()).filter((e) => e.data.resuelto);
const registros = todos.flatMap((e) => {
  const a = getAsignatura(e.data.asignatura)!;
  return estructura(e.body).flatMap((b) =>
    b.ejercicios.map((ej) => ({
      url: `${urlExamen(e)}#ej-${ej.id}`,
      asig: a.slug,
      asigNombre: a.nombreCorto,
      anio: e.data.anio,
      conv: nombreConvocatoria(e.data.convocatoria),
      coord: ej.id,
      tema: ej.tema ? nombreBloque(a, ej.tema) : b.titulo,
      texto: [ej.texto, ...ej.apartados.map((ap) => `${ap.letra}) ${ap.texto}`)].join(' '),
    })),
  );
});
const conExamenes = asignaturas.filter((a) => a.disponible);
const estilos = Object.fromEntries(conExamenes.map((a) => [a.slug, estiloAcento(a)]));
---
<Base
  titulo="Buscar ejercicios de la PEvAU resueltos | Andalucía"
  descripcion="Busca entre todos los ejercicios resueltos de la PEvAU de Andalucía por tema, año o palabra clave."
  seccion="buscar"
>
  <div class="wrap">
    <nav class="migas" aria-label="Migas de pan"><ol><li><a href="/">Inicio</a></li><li aria-current="page">Buscar</li></ol></nav>
    <h1 class="display buscar__h1">Buscar ejercicios</h1>

    <form class="buscar" role="search" data-buscar>
      <label class="buscar__campo">
        <span class="form__rotulo">Palabra clave, tema o año</span>
        <span class="buscar__input">
          <Icono nombre="buscar" />
          <input type="search" name="q" placeholder="p. ej. satélite, lente, 2024, matrices" autocomplete="off" spellcheck="false" />
        </span>
      </label>
      <fieldset class="buscar__asig">
        <legend class="form__rotulo">Asignatura</legend>
        <label><input type="radio" name="asig" value="" checked /><span>Todas</span></label>
        {conExamenes.map((a) => <label><input type="radio" name="asig" value={a.slug} /><span>{a.nombreCorto}</span></label>)}
      </fieldset>
    </form>

    <p class="buscar__cuenta" role="status" aria-live="polite" data-cuenta></p>
    <ol class="resultados" data-resultados></ol>
    <div class="buscar__vacio" data-vacio hidden>
      <h2>Nada con esas palabras</h2>
      <p>Prueba con el nombre del tema ("ondas", "probabilidad"), una magnitud ("periodo", "campo") o un año.</p>
    </div>
  </div>

  <script type="application/json" id="indice-busqueda" set:html={JSON.stringify({ registros, estilos })} />
</Base>

<script>
  import { initBuscar } from '../lib/buscar';
  initBuscar();
</script>

<style>
  .buscar__h1 { font-size: var(--t-2xl); margin-top: var(--s-4); }
  .buscar { margin-top: var(--s-5); display: grid; gap: var(--s-4); border-top: 3px solid var(--ink); padding-top: var(--s-4); }
  .buscar__campo { display: grid; gap: var(--s-2); }
  .buscar__input {
    display: flex; align-items: center; gap: var(--s-3);
    border: var(--b-form) solid var(--rule-ink); background: var(--paper-2);
    padding: 0 var(--s-4);
  }
  .buscar__input:focus-within { outline: 2px solid var(--ink); outline-offset: 2px; }
  .buscar__input input {
    flex: 1; min-width: 0; min-height: 3.25rem; border: 0; background: none; outline: none;
    font: 600 var(--t-md)/1 var(--f-frame); font-stretch: 92%;
  }
  .buscar__input input::placeholder { color: var(--ink-3); font-weight: 400; }
  .buscar__asig { border: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-2); align-items: center; }
  .buscar__asig legend { margin-bottom: var(--s-2); }
  .buscar__asig label { position: relative; }
  .buscar__asig input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  .buscar__asig span {
    display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 var(--s-3);
    border: var(--b-hair) solid var(--rule-ink);
    font: 650 var(--t-sm)/1 var(--f-frame); font-stretch: var(--stretch-frame); text-transform: uppercase; letter-spacing: var(--track-caps);
  }
  .buscar__asig input:checked + span { background: var(--ink); color: var(--paper); }
  .buscar__asig input:focus-visible + span { outline: 2px solid var(--ink); outline-offset: 2px; }
  .buscar__cuenta { margin-top: var(--s-5); font: 650 var(--t-sm)/1 var(--f-frame); font-stretch: var(--stretch-frame); text-transform: uppercase; letter-spacing: var(--track-caps); color: var(--ink-2); }
  .resultados { list-style: none; padding: 0; margin-top: var(--s-3); border-top: var(--b-form) solid var(--rule-ink); }
  .buscar__vacio { margin-top: var(--s-4); border: var(--b-form) dashed var(--ink-2); padding: var(--s-5); }
  .buscar__vacio h2 { font: 800 var(--t-lg)/1.1 var(--f-frame); font-stretch: var(--stretch-frame); text-transform: uppercase; }
  .buscar__vacio p { margin-top: var(--s-2); color: var(--ink-2); }
  @media (min-width: 48rem) { .buscar { grid-template-columns: minmax(0, 1.4fr) auto; align-items: end; } }
</style>

<style is:global>
  .res { position: relative; display: grid; grid-template-columns: 3.5rem minmax(0, 1fr); gap: var(--s-3); padding: var(--s-4) 0; border-bottom: var(--b-hair) solid var(--rule-ink); }
  .res:hover { background: var(--fill); }
  .res__coord { font: 800 var(--t-lg)/1 var(--f-frame); font-stretch: var(--stretch-frame); color: var(--acc); padding-top: 0.15rem; }
  .res__meta { font: 650 var(--t-xs)/1.2 var(--f-frame); font-stretch: var(--stretch-frame); text-transform: uppercase; letter-spacing: var(--track-caps); color: var(--ink-3); }
  .res__meta b { color: var(--ink); font-weight: 700; }
  .res__meta { margin-top: var(--s-1); }
  .res__tit { font: 650 var(--t-md)/1.25 var(--f-frame); font-stretch: 88%; }
  .res__tit a { text-decoration: none; }
  .res__tit a::after { content: ''; position: absolute; inset: 0; }
  .res__txt { margin-top: var(--s-1); font-size: var(--t-sm); line-height: 1.5; color: var(--ink-2); max-width: 70ch; }
  .res mark { background: none; color: var(--ink); font-weight: 650; box-shadow: inset 0 -0.4em 0 color-mix(in srgb, var(--acc) 25%, transparent); }
</style>
