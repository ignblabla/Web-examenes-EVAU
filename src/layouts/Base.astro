---
import "../styles/global.css"
import SiteFooter from "../components/SiteFooter.astro"
import SiteHeader from "../components/SiteHeader.astro"
import { sitio } from "../data/sitio"

interface Props {
  title: string
  description: string
  // Datos estructurados (schema.org) de la página, si los tiene.
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
  // Imagen para compartir (1200×630), relativa a la raíz de la web.
  image?: string
  // "article" en los exámenes y temas; "website" en el resto.
  type?: "website" | "article"
  // Fecha de la última revisión (AAAA-MM-DD), en los artículos.
  modified?: string
  // Páginas que no deben aparecer en Google (asignaturas sin resolver, 404).
  noindex?: boolean
}

const {
  title,
  description,
  jsonLd,
  image = "/og/inicio.png",
  type = "website",
  modified,
  noindex = false,
} = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
const imageUrl = new URL(image, Astro.site)
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {
      /* Google Analytics con Consent Mode v2: todo denegado hasta que el aviso de cookies
         registre que el visitante lo acepta, así que sin consentimiento no instala cookies.
         Solo en producción, para no contar las visitas de desarrollo. */
      import.meta.env.PROD && (
        <>
          <script is:inline define:vars={{ id: sitio.analytics }}>
            window.dataLayer = window.dataLayer || []
            window.gtag = function () {
              dataLayer.push(arguments)
            }
            gtag("consent", "default", {
              ad_storage: "denied",
              ad_user_data: "denied",
              ad_personalization: "denied",
              analytics_storage: "denied",
              wait_for_update: 500,
            })
            gtag("set", "ads_data_redaction", true)
            gtag("js", new Date())
            gtag("config", id)
          </script>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${sitio.analytics}`}
          />
        </>
      )
    }
    {
      /* AdSense, después del consentimiento por defecto. También carga el aviso de cookies
         que se configura en AdSense → Privacidad y mensajes, que actualiza ese consentimiento. */
      import.meta.env.PROD && sitio.adsense && (
        <>
          <meta name="google-adsense-account" content={sitio.adsense} />
          <script
            is:inline
            async
            src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${sitio.adsense}`}
            crossorigin="anonymous"
          />
        </>
      )
    }
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"}
    />
    {!noindex && <link rel="canonical" href={canonical} />}
    <!-- La serifa es la del H1, que es lo primero que se pinta. -->
    <link
      rel="preload"
      href="/fonts/instrument-serif-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/instrument-serif-latin-400-italic.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f5f1e8" />

    <meta property="og:type" content={type} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={sitio.nombre} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    {modified && <meta property="article:modified_time" content={modified} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <!-- Lo que cada página necesita en el <head> (el pie impreso de exámenes y temas). -->
    <slot name="head" />
  </head>
  <body>
    <div class="site-shell">
      <SiteHeader />
      <main>
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
