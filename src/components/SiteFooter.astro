---
import Logo from "./Logo.astro"
import { asignaturas } from "../data/asignaturas"
import { paginasLegales } from "../data/legal"

const enlaces = asignaturas.filter((a) => a.indexable)
---

<footer>
  <div class="container footer-inner">
    <Logo />
    <nav class="footer-nav" aria-label="Exámenes por asignatura">
      {
        enlaces.map((a) => (
          <a href={`/${a.slug}/`}>Exámenes de {a.nombre} de Selectividad</a>
        ))
      }
    </nav>
    <p>© {new Date().getFullYear()} · Exámenes resueltos de Selectividad de Andalucía</p>
    <nav class="footer-legal" aria-label="Información legal">
      {paginasLegales.map((p) => <a href={p.ruta}>{p.nombre}</a>)}
    </nav>
  </div>
</footer>
