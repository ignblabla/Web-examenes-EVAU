---
import Logo from "./Logo.astro"
import { asignaturas } from "../data/asignaturas"
import { cursos, rutaAnteriores, rutaCurso, rutaExtraordinaria, rutaNombres } from "../data/examenes"
import { paginasLegales } from "../data/legal"
import { autor, contacto } from "../data/sitio"

const enlaces = asignaturas.filter((a) => a.indexable)
---

<footer>
  <div class="container footer-inner">
    <Logo />
    <nav class="footer-nav" aria-label="Exámenes por asignatura">
      {
        enlaces.map((a) => (
          <a href={`/${a.slug}/`}>Exámenes de {a.nombre} de Selectividad</a>
        ))
      }
    </nav>
    <nav class="footer-nav" aria-label="Exámenes por año y convocatoria">
      {cursos.map((c) => <a href={rutaCurso(c.anio)}>Selectividad {c.anio}</a>)}
      <a href={rutaExtraordinaria}>Convocatoria extraordinaria</a>
      <a href={rutaAnteriores}>Años anteriores</a>
      <a href={rutaNombres}>PAU, PEvAU, EBAU o Selectividad</a>
    </nav>
    <div class="footer-bottom">
      <nav class="footer-legal" aria-label="Información legal">
        <a href={autor.ruta}>Sobre el autor</a>
        <a href={contacto.ruta}>{contacto.nombre}</a>
        {paginasLegales.map((p) => <a href={p.ruta}>{p.nombre}</a>)}
      </nav>
      <p>© {new Date().getFullYear()} · Exámenes resueltos de Selectividad de Andalucía</p>
    </div>
  </div>
</footer>
