---
// Índice lateral (escritorio). En móvil lo sustituye la tira de saltos.
import type { BloqueIdx } from '../lib/examenes';
interface Props { bloques: BloqueIdx[] }
const { bloques } = Astro.props;
---
<nav class="indice" aria-label="Índice de ejercicios">
  <div class="indice__pegado">
    <div class="indice__cab">
      <span class="form__rotulo">Índice</span>
      <span class="indice__crono num" data-crono-mini hidden aria-hidden="true"></span>
    </div>
    <ol class="indice__bloques">
      {bloques.map((b) => (
        <li>
          <a class="indice__bloque" href={`#bloque-${b.id}`} data-indice={`bloque-${b.id}`}>
            <b>{b.id}</b><span>{b.titulo}</span>
          </a>
          <ol class="indice__ejs">
            {b.ejercicios.map((ej) => (
              <li>
                <a class="indice__ej" href={`#ej-${ej.id}`} data-indice={`ej-${ej.id}`}>
                  <span class="num">{ej.id}</span>
                  <span class="indice__aps" aria-hidden="true">
                    {ej.apartados.map((ap) => <span class="casilla" data-casilla={ap.coord} title={ap.coord}></span>)}
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </li>
      ))}
    </ol>
    <p class="indice__leyenda"><span class="casilla" aria-hidden="true"></span> sin mirar <span class="casilla" data-estado="visto" aria-hidden="true"></span> solución vista</p>
  </div>
</nav>

<style>
  .indice { display: none; }
  @media (min-width: 64rem) { .indice { display: block; } }
  .indice__pegado { position: sticky; top: var(--s-4); max-height: calc(100dvh - 2rem); overflow-y: auto; padding-bottom: var(--s-4); }
  .indice__cab { display: flex; justify-content: space-between; align-items: center; border-bottom: var(--b-form) solid var(--rule-ink); padding-bottom: var(--s-2); min-height: 2.25rem; }
  .indice__crono { font: 800 var(--t-md)/1 var(--f-frame); padding: 0.2rem 0.4rem; border: var(--b-hair) solid var(--rule-ink); }
  .indice__crono[data-aviso='poco'] { color: var(--warn); border-color: currentColor; }
  .indice__crono[data-aviso='fin'] { background: var(--alarm); color: var(--paper); border-color: var(--alarm); }
  ol { list-style: none; padding: 0; }
  .indice__bloques > li { border-bottom: var(--b-hair) solid var(--rule); padding: var(--s-2) 0; }
  .indice__bloque { display: flex; gap: var(--s-2); align-items: baseline; padding: var(--s-1) var(--s-2); text-decoration: none; }
  .indice__bloque b { font: 800 var(--t-sm)/1 var(--f-frame); }
  .indice__bloque span { font: 500 var(--t-sm)/1.25 var(--f-frame); font-stretch: 88%; color: var(--ink-2); }
  .indice__ejs { margin-top: var(--s-1); }
  .indice__ej {
    display: flex; align-items: center; gap: var(--s-3);
    min-height: 2.25rem; padding: 0 var(--s-2) 0 var(--s-5);
    text-decoration: none;
    font: 700 var(--t-sm)/1 var(--f-frame); font-stretch: var(--stretch-frame);
    position: relative;
  }
  .indice__aps { display: flex; gap: 0.3rem; color: var(--ink-2); }
  .indice__aps .casilla { width: 0.7rem; height: 0.7rem; }
  .indice a:hover { background: var(--fill); }
  .indice a[aria-current='true'] { background: var(--ink); color: var(--paper); }
  .indice a[aria-current='true'] span { color: inherit; }
  .indice__leyenda {
    margin-top: var(--s-3); display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-1) var(--s-2);
    font: 500 var(--t-xs)/1.3 var(--f-frame); color: var(--ink-3);
  }
  .indice__leyenda .casilla { width: 0.7rem; height: 0.7rem; }
</style>
