---
// Matemáticas aplicadas, reserva 2 de 2025, ejercicio 3 a): índice de audiencia
// f(t) = −0.01t² + 0.8t + 20 en [0, 60]. El eje vertical empieza en 15.
import GraficaFuncion from "./GraficaFuncion.astro"
---

<GraficaFuncion
  xMin={-3}
  xMax={65}
  yMin={15}
  yMax={39}
  marcasX={[10, 20, 30, 40, 50, 60]}
  marcasY={[20, 25, 30, 35]}
  tramos={[{ f: (t) => -0.01 * t ** 2 + 0.8 * t + 20, desde: 0, hasta: 60 }]}
  puntos={[
    { x: 0, y: 20, texto: "(0, 20)", dx: 6, dy: 12 },
    { x: 40, y: 36, texto: "Máximo (40, 36)", dx: 0, dy: -8 },
    { x: 60, y: 32, texto: "(60, 32)", dx: 0, dy: 15 },
  ]}
  descripcion="Gráfica del índice de audiencia: arco de parábola que empieza en 20 puntos, sube hasta el máximo de 36 a los 40 minutos y baja hasta 32 a los 60 minutos"
/>
