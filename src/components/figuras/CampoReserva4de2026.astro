---
// Matemáticas II, reserva 4 de 2026, ejercicio 1: campo rectangular con un lado x junto al camino
// (valla de 80 euros el metro) y los otros tres lados de 10 euros el metro.
---

<figure class="solution-figure">
  <svg viewBox="0 0 260 180" role="img" aria-label="Campo rectangular de lados x e y; el lado x de abajo da al camino y su valla cuesta 80 euros el metro, y los otros tres lados, 10 euros el metro">
    <rect x="0" y="142" width="260" height="22" fill="#e9e4d8" />
    <text x="250" y="157" text-anchor="end" font-family="Arial, Helvetica, sans-serif" font-size="10" fill="#555">camino</text>
    <rect x="50" y="30" width="160" height="110" fill="#dcefe8" stroke="#111" stroke-width="1.5" />
    <path d="M50 140 H210" stroke="#195c51" stroke-width="5" />
    <g font-family="Arial, Helvetica, sans-serif" font-size="12" font-style="italic" fill="#b04a3a">
      <text x="130" y="22" text-anchor="middle">x</text>
      <text x="38" y="90" text-anchor="end">y</text>
      <text x="222" y="90">y</text>
    </g>
    <g font-family="Arial, Helvetica, sans-serif" font-size="10" fill="#195c51" font-weight="700">
      <text x="130" y="132" text-anchor="middle">80 €/m</text>
      <text x="130" y="44" text-anchor="middle">10 €/m</text>
    </g>
  </svg>
</figure>
