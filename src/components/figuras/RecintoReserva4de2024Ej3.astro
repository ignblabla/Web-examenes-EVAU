---
// Matemáticas aplicadas, reserva 4 de 2024, ejercicio 3 b): para a = 5 y b = 2, f vale 2/x en (1, 3]
// y (x − 1)/3 para x > 3; recinto con el eje entre x = 2 y x = 4.
import GraficaFuncion from "./GraficaFuncion.astro"

const f = (x: number) => (x <= 3 ? 2 / x : (x - 1) / 3)
---

<GraficaFuncion
  xMin={-0.4}
  xMax={5}
  yMin={-0.3}
  yMax={2.3}
  marcasX={[1, 2, 3, 4]}
  marcasY={[0.5, 1, 1.5, 2]}
  tramos={[{ f, desde: 1.02, hasta: 4.8 }]}
  recinto={{ arriba: f, abajo: () => 0, desde: 2, hasta: 4 }}
  puntos={[
    { x: 2, y: 1, texto: "(2, 1)", dx: -6, dy: 12 },
    { x: 3, y: 2 / 3, texto: "(3, ⅔)", dx: 0, dy: -9 },
    { x: 4, y: 1, texto: "(4, 1)", dx: 6, dy: 12 },
  ]}
  descripcion="Gráfica de f entre x = 1 y x = 5: la hipérbola 2/x baja hasta (3, 2/3) y desde ahí la recta (x − 1)/3 sube; el recinto entre x = 2 y x = 4 bajo la gráfica está sombreado"
/>
