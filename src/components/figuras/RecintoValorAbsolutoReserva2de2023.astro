---
// Matemáticas II, reserva 2 de 2023, ejercicio 4: recinto entre la recta g(x) = x + 5, por
// arriba, y f(x) = |x² − 1|, por abajo, que se cortan en (−2, 3) y (3, 8).
import GraficaFuncion from "./GraficaFuncion.astro"

const f = (x: number) => Math.abs(x ** 2 - 1)
const g = (x: number) => x + 5
---

<GraficaFuncion
  xMin={-3}
  xMax={3.8}
  yMin={-0.9}
  yMax={9.6}
  marcasX={[-2, -1, 1, 2, 3]}
  marcasY={[1, 3, 5, 7, 9]}
  tramos={[
    { f, desde: -3, hasta: 3.3, etiqueta: { texto: "f", x: -2.55, y: 6.2, ancla: "end" } },
    { f: g, desde: -3, hasta: 3.75, color: "#b04a3a", etiqueta: { texto: "g", x: 3.6, y: 7.6, ancla: "end" } },
  ]}
  recinto={{ arriba: g, abajo: f, desde: -2, hasta: 3 }}
  puntos={[
    { x: -2, y: 3, texto: "(−2, 3)", dx: -10, dy: -8 },
    { x: 3, y: 8, texto: "(3, 8)", dx: -10, dy: -8 },
  ]}
  descripcion="Gráfica de f(x) = |x² − 1|, que toca el eje X en x = −1 y x = 1 y tiene un pico en (0, 1), y la recta g(x) = x + 5. Se cortan en (−2, 3) y (3, 8). El recinto sombreado queda entre la recta, por arriba, y f, por abajo, desde x = −2 hasta x = 3"
/>
