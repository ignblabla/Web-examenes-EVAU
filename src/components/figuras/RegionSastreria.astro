---
// Matemáticas aplicadas, reserva 3 de 2022, ejercicio 2: región factible de los trajes (x) y
// los vestidos (y).
import RegionFactible from "./RegionFactible.astro"
---

<RegionFactible
  xMax={78}
  yMax={80}
  marcasX={[10, 20, 30, 40, 50, 60, 70]}
  marcasY={[10, 20, 30, 40, 50, 60, 70]}
  rectas={[
    { desde: [0, 35], hasta: [70, 0], color: "#2f6fa3", etiqueta: "x + 2y = 70", en: [56, 12] },
    { desde: [23.3, 80], hasta: [50, 0], color: "#b04a3a", etiqueta: "3x + 2y = 150", en: [33, 52] },
  ]}
  region={[
    [0, 0],
    [50, 0],
    [40, 15],
    [0, 35],
  ]}
  vertices={[
    { x: 0, y: 0, texto: "O", dx: -10, dy: 14 },
    { x: 50, y: 0, texto: "A", dx: 6, dy: -6 },
    { x: 40, y: 15, texto: "B", dx: 6, dy: -6 },
    { x: 0, y: 35, texto: "C", dx: 6, dy: -6 },
  ]}
  descripcion="Región factible: cuadrilátero de vértices O(0, 0), A(50, 0), B(40, 15) y C(0, 35), limitado por los ejes y las rectas x + 2y = 70 y 3x + 2y = 150"
/>
