---
// Física, junio 2025, B) b1: espira rectangular con un lado móvil de longitud a que se
// desplaza con velocidad v dentro de un campo magnético B saliente del papel.
const puntos = [
  [70, 36],
  [96, 36],
  [122, 36],
  [70, 68],
  [96, 68],
  [122, 68],
]
---

<figure class="official-figure">
  <svg
    viewBox="0 0 150 112"
    role="img"
    aria-label="Espira rectangular con un lado móvil de longitud a que se mueve hacia la derecha con velocidad v dentro de un campo magnético B saliente del papel"
  >
    <g fill="none" stroke="#111" stroke-width="1.3">
      <!-- Espira -->
      <path d="M28 14H142V100H28Z" />
      <!-- Lado móvil -->
      <path d="M44 4V110M50 4V110" stroke-width="1.6" />
      <!-- Cota a -->
      <path d="M12 16V98M9 21l3-5 3 5M9 93l3 5 3-5" />
      <!-- Velocidad -->
      <path d="M54 7H92M87 4l5 3-5 3" />
      <!-- Campo saliente -->
      {puntos.map(([x, y]) => <circle cx={x} cy={y} r="5" />)}
      <path d="M102 86H114M110 84l4 2-4 2" stroke-width="1" />
    </g>
    <g fill="#111">
      {puntos.map(([x, y]) => <circle cx={x} cy={y} r="1.4" />)}
      <circle cx="35" cy="36" r="1.4" />
      <circle cx="35" cy="68" r="1.4" />
    </g>
    <g fill="none" stroke="#111" stroke-width="1.3">
      <circle cx="35" cy="36" r="5" />
      <circle cx="35" cy="68" r="5" />
    </g>
    <g font-family="'Times New Roman', Times, serif" font-style="italic" fill="#111">
      <text x="2" y="61" font-size="15">a</text>
      <text x="96" y="16" font-size="15">v</text>
      <text x="103" y="99" font-size="15">B</text>
    </g>
    <path d="M95 4H102M99 2l3 2-3 2" fill="none" stroke="#111" stroke-width="0.9" />
  </svg>
</figure>
