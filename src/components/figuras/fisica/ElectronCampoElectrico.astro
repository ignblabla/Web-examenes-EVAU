---
// Física, reserva 3 de 2021, B2 a: electrón lanzado perpendicularmente a las líneas de un campo
// eléctrico uniforme, entre dos placas (la positiva arriba). El campo apunta hacia abajo y la
// fuerza sobre el electrón, F = −eE, hacia arriba: describe una parábola que se curva hacia la
// placa positiva, como un tiro horizontal «hacia arriba».
const id = `electron-e-${Math.round(Math.random() * 1e9)}`
const x0 = 50
const y0 = 150
// Parábola y = y0 − a·(x − x0)²
const a = 0.0036
const puntos = Array.from({ length: 18 }, (_, i) => {
  const x = x0 + i * 10
  return `${i ? "L" : "M"}${x} ${(y0 - a * (x - x0) ** 2).toFixed(1)}`
}).join("")
---

<figure class="solution-figure">
  <svg
    viewBox="0 0 340 220"
    role="img"
    aria-label="Dos placas horizontales, la positiva arriba y la negativa abajo, con el campo eléctrico uniforme dirigido hacia abajo. Un electrón entra horizontalmente por la izquierda, perpendicular al campo. La fuerza eléctrica sobre él apunta hacia arriba, en sentido contrario al campo, y su trayectoria es una parábola que se curva hacia la placa positiva."
  >
    <defs>
      <marker id={`${id}-a`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" fill="#2d6fa3" />
      </marker>
      <marker id={`${id}-v`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" fill="#195c51" />
      </marker>
      <marker id={`${id}-r`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" fill="#b04a3a" />
      </marker>
    </defs>
    <rect x="40" y="22" width="270" height="8" fill="#e8c4bd" stroke="#b04a3a" />
    <rect x="40" y="190" width="270" height="8" fill="#c9d9e6" stroke="#2d6fa3" />
    <g font-family="Arial, Helvetica, sans-serif" font-size="13" font-weight="700">
      <text x="318" y="31" fill="#b04a3a">+</text>
      <text x="318" y="199" fill="#2d6fa3">−</text>
    </g>
    <g stroke="#2d6fa3" stroke-width="1" opacity="0.7">
      {[90, 150, 210, 270].map((x) => <path d={`M${x} 36V182`} marker-end={`url(#${id}-a)`} />)}
    </g>
    <text x="276" y="110" font-family="Arial, Helvetica, sans-serif" font-size="12" font-style="italic" font-weight="700" fill="#2d6fa3">E</text>
    <path d={puntos} fill="none" stroke="#172c27" stroke-width="1.6" stroke-dasharray="5 3" />
    <path d={`M${x0 - 30} ${y0}h22`} stroke="#195c51" stroke-width="1.8" marker-end={`url(#${id}-v)`} />
    <text x={x0 - 28} y={y0 - 8} font-family="Arial, Helvetica, sans-serif" font-size="12" font-style="italic" font-weight="700" fill="#195c51">v₀</text>
    <circle cx={x0} cy={y0} r="7" fill="#dfe9f0" stroke="#2d6fa3" />
    <text x={x0} y={y0 + 4} text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="11" font-weight="700" fill="#2d6fa3">−</text>
    <path d={`M${x0 + 130} ${(y0 - a * 130 ** 2).toFixed(1)}v-30`} stroke="#b04a3a" stroke-width="1.8" marker-end={`url(#${id}-r)`} />
    <text x={x0 + 136} y={(y0 - a * 130 ** 2 - 18).toFixed(1)} stroke="#fff" stroke-width="4" paint-order="stroke" font-family="Arial, Helvetica, sans-serif" font-size="12" font-style="italic" font-weight="700" fill="#b04a3a">F = −eE</text>
  </svg>
</figure>
