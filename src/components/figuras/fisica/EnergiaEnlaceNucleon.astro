---
// Curva de la energía de enlace por nucleón frente al número másico (valores aproximados, en
// MeV). Crece en los núcleos ligeros (con el pico del helio-4), tiene el máximo en torno al
// hierro-56 y baja lentamente en los pesados. Las flechas indican la fusión de núcleos ligeros
// y la fisión de núcleos pesados, que avanzan hacia la zona más estable.
const puntos: [number, number][] = [
  [2, 1.11], [3, 2.6], [4, 7.07], [6, 5.33], [7, 5.61], [9, 6.46], [12, 7.68], [16, 7.98],
  [20, 8.03], [28, 8.45], [40, 8.55], [56, 8.79], [80, 8.71], [100, 8.6], [120, 8.51],
  [150, 8.3], [180, 8.05], [200, 7.92], [238, 7.57],
]
const px = (a: number) => 52 + a * 1.36
const py = (e: number) => 196 - e * 19
const linea = puntos.map(([a, e], i) => `${i ? "L" : "M"}${px(a).toFixed(1)} ${py(e).toFixed(1)}`).join("")
const id = `enlace-${Math.round(Math.random() * 1e9)}`
---

<figure class="solution-figure">
  <svg viewBox="0 0 400 236" role="img" aria-label="Gráfica de la energía de enlace por nucleón frente al número másico. Sube rápidamente en los núcleos ligeros, con un pico en el helio-4, alcanza un máximo de unos 8,8 MeV en torno al hierro-56 y baja lentamente hasta unos 7,6 MeV en el uranio-238. Una flecha indica que la fusión de núcleos ligeros sube por la curva hacia el máximo, y otra que la fisión de núcleos pesados también avanza hacia él.">
    <defs>
      <marker id={id} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" fill="#b04a3a" />
      </marker>
      <marker id={`${id}-n`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" fill="#111" />
      </marker>
    </defs>
    <g stroke="#111" stroke-width="1.2" fill="none">
      <path d={`M${px(0)} ${py(0)}H${px(255)}`} marker-end={`url(#${id}-n)`} />
      <path d={`M${px(0)} ${py(0)}V${py(9.9)}`} marker-end={`url(#${id}-n)`} />
    </g>
    <g font-family="Arial, Helvetica, sans-serif" font-size="10" fill="#333">
      {[50, 100, 150, 200].map((a) => <text x={px(a)} y={py(0) + 14} text-anchor="middle">{a}</text>)}
      {[2, 4, 6, 8].map((e) => <text x={px(0) - 6} y={py(e) + 3} text-anchor="end">{e}</text>)}
      <text x={px(255)} y={py(0) + 28} text-anchor="end" font-style="italic">A (número másico)</text>
      <text x={px(0) + 6} y={py(9.9) + 2} font-style="italic">E<tspan dy="3" font-size="8">e</tspan><tspan dy="-3">/A (MeV)</tspan></text>
    </g>
    <g stroke="#ddd" stroke-width="0.8">
      {[2, 4, 6, 8].map((e) => <path d={`M${px(0)} ${py(e)}H${px(245)}`} />)}
    </g>
    <path d={linea} fill="none" stroke="#2d6fa3" stroke-width="2" />
    <g fill="#2d6fa3" font-family="Arial, Helvetica, sans-serif" font-size="10">
      <circle cx={px(4)} cy={py(7.07)} r="2.6" />
      <text x={px(4) + 6} y={py(7.07) + 12}>⁴He</text>
      <circle cx={px(56)} cy={py(8.79)} r="2.6" />
      <text x={px(56)} y={py(8.79) - 8} text-anchor="middle">⁵⁶Fe (máximo)</text>
      <circle cx={px(238)} cy={py(7.57)} r="2.6" />
      <text x={px(238)} y={py(7.57) + 14} text-anchor="middle">²³⁸U</text>
    </g>
    <g stroke="#b04a3a" stroke-width="1.6" fill="none">
      <path d={`M${px(10)} ${py(4)}Q${px(18)} ${py(6.4)} ${px(36)} ${py(7.2)}`} marker-end={`url(#${id})`} />
      <path d={`M${px(225)} ${py(6.6)}Q${px(190)} ${py(6.3)} ${px(130)} ${py(7.4)}`} marker-end={`url(#${id})`} />
    </g>
    <g font-family="Arial, Helvetica, sans-serif" font-size="11" font-weight="700" fill="#b04a3a">
      <text x={px(14)} y={py(3.2)}>Fusión</text>
      <text x={px(206)} y={py(5.9)} text-anchor="middle">Fisión</text>
    </g>
  </svg>
</figure>
