---
// Cuerpo arrastrado por un suelo horizontal con una cuerda que forma un ángulo con el suelo
// (Física, junio de 2025, A b1: la maleta). Dibuja el peso, la normal, la tensión con sus
// componentes y el rozamiento, opuesto al movimiento. Las flechas no están a escala.
// Con izquierda, la fuerza tira hacia atrás (contra el movimiento, que sigue hacia la derecha):
// el rozamiento se dibuja entonces en la base del cuerpo para no tapar la componente Fx.
interface Props {
  angulo: number
  izquierda?: boolean
  // Nombre de la fuerza aplicada y texto junto a la flecha de la velocidad.
  fuerza?: string
  nota?: string
  descripcion: string
}

const { angulo, izquierda = false, fuerza = "T", nota = "v constante", descripcion } = Astro.props
const th = (angulo * Math.PI) / 180
const sx = izquierda ? -1 : 1
const c = { x: 170, y: 130 }
const id = `tiro-${Math.round(Math.random() * 1e9)}`
const lt = 92
const tension = { x: c.x + sx * lt * Math.cos(th), y: c.y - lt * Math.sin(th) }
// Origen del rozamiento: el centro o, si la fuerza tira hacia atrás, la base del cuerpo.
const roce = { x: c.x, y: izquierda ? c.y + 20 : c.y }
const colores = ["#111", "#195c51", "#b04a3a", "#2d6fa3"]
const marca = (color: string) => `url(#${id}-${colores.indexOf(color)})`
const r = 22
---

<figure class="solution-figure">
  <svg viewBox="0 0 360 210" role="img" aria-label={descripcion}>
    <defs>
      {
        colores.map((color, i) => (
          <marker id={`${id}-${i}`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M0 0L10 5L0 10z" fill={color} />
          </marker>
        ))
      }
    </defs>
    <path d="M20 158H340" stroke="#111" stroke-width="1.2" />
    <path d="M20 158l-8 8M44 158l-8 8M68 158l-8 8M92 158l-8 8M116 158l-8 8M140 158l-8 8M164 158l-8 8M188 158l-8 8M212 158l-8 8M236 158l-8 8M260 158l-8 8M284 158l-8 8M308 158l-8 8M332 158l-8 8" stroke="#999" stroke-width="0.8" />
    <rect x={c.x - 34} y={c.y - 28} width="68" height="56" rx="6" fill="#c9bce8" stroke="#111" stroke-width="1.2" />

    <path d={`M${c.x + sx * r} ${c.y}A${r} ${r} 0 0 ${izquierda ? 1 : 0} ${(c.x + sx * r * Math.cos(th)).toFixed(1)} ${(c.y - r * Math.sin(th)).toFixed(1)}`} fill="none" stroke="#2d6fa3" stroke-width="1" />
    <text x={izquierda ? c.x - 40 : c.x + 38} y={izquierda ? c.y - 5 : c.y - 9} text-anchor="end" font-family="Arial, Helvetica, sans-serif" font-size="10" fill="#2d6fa3">{angulo}°</text>

    <g stroke-width="1.7" fill="none">
      <path d={`M${c.x} ${c.y}V${c.y + 62}`} stroke="#111" marker-end={marca("#111")} />
      <path d={`M${c.x} ${c.y}V${c.y - 60}`} stroke="#195c51" marker-end={marca("#195c51")} />
      <path d={`M${roce.x} ${roce.y}H${roce.x - 62}`} stroke="#b04a3a" marker-end={marca("#b04a3a")} />
      <path d={`M${c.x} ${c.y}L${tension.x.toFixed(1)} ${tension.y.toFixed(1)}`} stroke="#2d6fa3" marker-end={marca("#2d6fa3")} />
      <path d={`M${c.x} ${c.y}H${tension.x.toFixed(1)}`} stroke="#2d6fa3" stroke-dasharray="4 3" stroke-width="1.2" />
      <path d={`M${tension.x.toFixed(1)} ${c.y}V${tension.y.toFixed(1)}`} stroke="#2d6fa3" stroke-dasharray="4 3" stroke-width="1.2" />
    </g>
    <path d="M250 182h44" stroke="#555" stroke-width="1" marker-end={marca("#111")} />
    <g font-family="Arial, Helvetica, sans-serif" font-size="12" font-weight="700">
      <text x={c.x + 8} y={c.y + 62} fill="#111">P</text>
      <text x={c.x - 18} y={c.y - 54} fill="#195c51">N</text>
      <text x={roce.x - 66} y={roce.y + 4} text-anchor="end" fill="#b04a3a">F<tspan dy="3" font-size="9">r</tspan></text>
      <text x={tension.x + sx * 6} y={tension.y + 2} text-anchor={izquierda ? "end" : "start"} fill="#2d6fa3">{fuerza}</text>
      <text x={tension.x + sx * 6} y={izquierda ? c.y - 4 : c.y + 14} text-anchor={izquierda ? "end" : "start"} fill="#2d6fa3" font-weight="400" font-size="10">{fuerza}<tspan dy="3" font-size="8">x</tspan></text>
      <text x={tension.x + sx * 6} y={(c.y + tension.y) / 2 + 4} text-anchor={izquierda ? "end" : "start"} fill="#2d6fa3" font-weight="400" font-size="10">{fuerza}<tspan dy="3" font-size="8">y</tspan></text>
      <text x="300" y="186" fill="#555" font-weight="400" font-style="italic" font-size="11">{nota}</text>
    </g>
  </svg>
</figure>
