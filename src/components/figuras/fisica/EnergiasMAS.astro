---
// Energías de un oscilador armónico en función de la posición x, entre −A y A:
// Ep = ½kx² (parábola), Ec = ½k(A² − x²) (parábola invertida) y Em = ½kA² (constante).
const ancho = 320
const alto = 170
const x0 = 180
const yEje = 190
const escalaX = 130
const escalaY = 150
const px = (x: number) => x0 + x * escalaX
const py = (e: number) => yEje - e * escalaY
const curva = (f: (x: number) => number) =>
  Array.from({ length: 81 }, (_, i) => -1 + i / 40)
    .map((x, i) => `${i ? "L" : "M"}${px(x).toFixed(1)} ${py(f(x)).toFixed(1)}`)
    .join("")
const id = `mas-${Math.round(Math.random() * 1e9)}`
---

<figure class="solution-figure">
  <svg viewBox={`0 0 ${ancho + 40} ${alto + 50}`} role="img" aria-label="Energías de un movimiento armónico simple frente a la posición x, entre menos A y A. La energía potencial es una parábola con mínimo nulo en x = 0 y máximo en los extremos; la cinética es una parábola invertida, máxima en x = 0 y nula en los extremos; la mecánica es una recta horizontal igual a un medio de k por A al cuadrado.">
    <defs>
      <marker id={id} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" fill="#111" />
      </marker>
    </defs>
    <g stroke="#111" stroke-width="1" fill="none">
      <path d={`M${px(-1.2)} ${yEje}H${px(1.25)}`} marker-end={`url(#${id})`} />
      <path d={`M${x0} ${yEje + 6}V${py(1.2)}`} marker-end={`url(#${id})`} />
      <path d={`M${px(-1)} ${yEje - 3}v6M${px(1)} ${yEje - 3}v6`} />
      <path d={`M${px(-1)} ${py(1)}V${yEje}M${px(1)} ${py(1)}V${yEje}`} stroke="#bbb" stroke-dasharray="3 3" />
    </g>
    <path d={curva(() => 1)} fill="none" stroke="#172c27" stroke-width="2" />
    <path d={curva((x) => x * x)} fill="none" stroke="#b04a3a" stroke-width="2" />
    <path d={curva((x) => 1 - x * x)} fill="none" stroke="#195c51" stroke-width="2" />
    <g font-family="Arial, Helvetica, sans-serif" font-size="11">
      <text x={px(-1)} y={yEje + 15} text-anchor="middle">−A</text>
      <text x={px(1)} y={yEje + 15} text-anchor="middle">A</text>
      <text x={x0 - 4} y={yEje + 15} text-anchor="end">0</text>
      <text x={px(1.25)} y={yEje - 6} text-anchor="end" font-style="italic">x</text>
      <text x={x0 + 6} y={py(1.2) + 4} font-style="italic">E</text>
      <text x={px(-1) + 4} y={py(1) - 6} font-weight="700" fill="#172c27">E<tspan dy="3" font-size="8">m</tspan><tspan dy="-3"> = ½kA²</tspan></text>
      <text x={px(0.72)} y={py(0.28)} font-weight="700" fill="#b04a3a">E<tspan dy="3" font-size="8">p</tspan></text>
      <text x={px(-0.3)} y={py(0.78)} text-anchor="middle" font-weight="700" fill="#195c51">E<tspan dy="3" font-size="8">c</tspan></text>
    </g>
  </svg>
</figure>
