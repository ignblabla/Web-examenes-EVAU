---
// Física, junio de 2021, B1 a: espira circular que avanza hacia la derecha por el plano XY y
// atraviesa una región con campo magnético entrante (B en −k). Tres momentos: mientras entra,
// el flujo entrante aumenta y la corriente inducida es antihoraria (campo inducido saliente);
// dentro del campo el flujo no cambia y no hay corriente; mientras sale, el flujo disminuye y
// la corriente es horaria (campo inducido entrante).
const id = `entra-sale-${Math.round(Math.random() * 1e9)}`
const r = 32
const cy = 104
const paneles = [
  { x0: 0, dx: 60, titulo: "Entra: Φ aumenta", pie: "I antihoraria · B inducido saliente", sentido: "anti" },
  { x0: 180, dx: 105, titulo: "Dentro: Φ constante", pie: "No hay corriente inducida", sentido: "" },
  { x0: 360, dx: 150, titulo: "Sale: Φ disminuye", pie: "I horaria · B inducido entrante", sentido: "horaria" },
]
const cruces = (x0: number) =>
  [0, 1, 2, 3].flatMap((i) => [0, 1, 2, 3].map((j) => ({ x: x0 + 72 + i * 22, y: 50 + j * 36 })))
---

<figure class="solution-figure solution-figure--wide">
  <svg
    viewBox="0 0 550 210"
    role="img"
    aria-label="Tres esquemas de una espira circular que avanza hacia la derecha y atraviesa una región con campo magnético entrante en el papel. Primero, mientras entra: el flujo aumenta, el campo inducido en su interior es saliente y la corriente inducida circula en sentido antihorario. Segundo, con la espira entera dentro del campo: el flujo no cambia y no hay corriente. Tercero, mientras sale: el flujo disminuye, el campo inducido es entrante y la corriente circula en sentido horario."
  >
    <defs>
      <marker id={`${id}-r`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" fill="#b04a3a" />
      </marker>
      <marker id={`${id}-v`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" fill="#195c51" />
      </marker>
    </defs>
    {
      paneles.map((p) => {
        const cx = p.x0 + p.dx
        // Flechas tangentes arriba y abajo de la espira (y crece hacia abajo en el SVG).
        const arriba = p.sentido === "anti" ? [cx + 9, cx - 9] : [cx - 9, cx + 9]
        const abajo = p.sentido === "anti" ? [cx - 9, cx + 9] : [cx + 9, cx - 9]
        return (
          <g>
            <rect x={p.x0 + 60} y="30" width="90" height="148" fill="rgba(201, 188, 232, 0.25)" stroke="#bbb" stroke-dasharray="4 3" />
            <g stroke="#aaa" stroke-width="1">
              {cruces(p.x0).map((q) => (
                <path d={`M${q.x - 3} ${q.y - 3}l6 6m0 -6l-6 6`} />
              ))}
            </g>
            <text x={p.x0 + 146} y="174" text-anchor="end" font-family="Arial, Helvetica, sans-serif" font-size="9" fill="#888">B (entrante)</text>
            <circle cx={cx} cy={cy} r={r} fill="none" stroke="#172c27" stroke-width="2" />
            <path d={`M${cx - 14} ${cy - r - 12}h28`} stroke="#195c51" stroke-width="1.8" marker-end={`url(#${id}-v)`} />
            <text x={cx + 18} y={cy - r - 8} font-family="Arial, Helvetica, sans-serif" font-size="12" font-style="italic" font-weight="700" fill="#195c51">v</text>
            <text x={p.x0 + 6} y="16" font-family="Arial, Helvetica, sans-serif" font-size="11" font-weight="700" fill="#111">{p.titulo}</text>
            <text x={p.x0 + 90} y="200" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="9.5" fill={p.sentido ? "#b04a3a" : "#111"}>{p.pie}</text>
            {p.sentido && (
              <g stroke="#b04a3a" stroke-width="2" fill="none">
                <path d={`M${arriba[0]} ${cy - r}H${arriba[1]}`} marker-end={`url(#${id}-r)`} />
                <path d={`M${abajo[0]} ${cy + r}H${abajo[1]}`} marker-end={`url(#${id}-r)`} />
                <circle cx={cx} cy={cy} r="8" fill="#fff" stroke-width="1.4" />
                {p.sentido === "anti" ? (
                  <circle cx={cx} cy={cy} r="1.8" fill="#b04a3a" stroke="none" />
                ) : (
                  <path d={`M${cx - 5.5} ${cy - 5.5}l11 11m0 -11l-11 11`} stroke-width="1.4" />
                )}
              </g>
            )}
          </g>
        )
      })
    }
  </svg>
</figure>
