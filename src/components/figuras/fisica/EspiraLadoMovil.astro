---
// Física, junio de 2025, B b1: espira rectangular con un lado móvil de longitud a que se
// desplaza con velocidad v dentro de un campo magnético B saliente del papel. Es la figura del
// enunciado. Con solucion, la de la respuesta: la espira que forma el lado móvil con la parte
// derecha del marco, la corriente inducida en sentido antihorario (en el lado móvil, hacia
// abajo) y el campo inducido, saliente, en su interior.
interface Props {
  solucion?: boolean
}

const { solucion = false } = Astro.props
const campo = [
  [70, 36],
  [96, 36],
  [122, 36],
  [70, 68],
  [96, 68],
  [122, 68],
]
const id = `espira-movil-${Math.round(Math.random() * 1e9)}`
---

<figure class={solucion ? "solution-figure" : "official-figure"}>
  <svg
    viewBox="0 0 150 112"
    role="img"
    aria-label={
      solucion
        ? "La misma espira con la corriente inducida: en el lado móvil baja, y en la espira que forma con la parte derecha del marco circula en sentido antihorario; el campo inducido dentro de esa espira es saliente, como el campo B."
        : "Espira rectangular con un lado móvil de longitud a que se mueve hacia la derecha con velocidad v dentro de un campo magnético B saliente del papel"
    }
  >
    <defs>
      <marker id={id} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" fill="#b04a3a" />
      </marker>
    </defs>
    <g fill="none" stroke="#111" stroke-width="1.3">
      <path d="M28 14H142V100H28Z" />
      <path d="M44 4V110M50 4V110" stroke-width="1.6" />
      <path d="M12 16V98M9 21l3-5 3 5M9 93l3 5 3-5" />
      <path d="M54 7H92M87 4l5 3-5 3" />
      {!solucion && <path d="M102 86H114M110 84l4 2-4 2" stroke-width="1" />}
    </g>
    <g fill="none" stroke={solucion ? "#bbb" : "#111"} stroke-width="1.3">
      {campo.map(([x, y]) => <circle cx={x} cy={y} r="5" />)}
      <circle cx="35" cy="36" r="5" />
      <circle cx="35" cy="68" r="5" />
    </g>
    <g fill={solucion ? "#bbb" : "#111"}>
      {campo.map(([x, y]) => <circle cx={x} cy={y} r="1.4" />)}
      <circle cx="35" cy="36" r="1.4" />
      <circle cx="35" cy="68" r="1.4" />
    </g>
    <g font-family="'Times New Roman', Times, serif" font-style="italic" fill="#111">
      <text x="2" y="61" font-size="15">a</text>
      <text x="96" y="16" font-size="15">v</text>
      {!solucion && <text x="103" y="99" font-size="15">B</text>}
    </g>
    {!solucion && <path d="M95 4H102M99 2l3 2-3 2" fill="none" stroke="#111" stroke-width="0.9" />}
    {
      solucion && (
        <g>
          <g fill="none" stroke="#b04a3a" stroke-width="1.4" marker-end={`url(#${id})`}>
            <path d="M47 30V74" />
            <path d="M70 94H118" />
            <path d="M136 84V40" />
            <path d="M118 20H70" />
          </g>
          <g fill="none" stroke="#b04a3a" stroke-width="1.3">
            <circle cx="96" cy="52" r="7" />
          </g>
          <circle cx="96" cy="52" r="2" fill="#b04a3a" />
          <text x="96" y="86" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="7" fill="#b04a3a">B inducido</text>
          <text x="58" y="108" font-family="Arial, Helvetica, sans-serif" font-size="7" fill="#b04a3a">I (antihoraria)</text>
        </g>
      )
    }
  </svg>
</figure>
