---
// Física, reserva 2 de 2024, B2 b: un protón parte del reposo, se acelera entre dos placas con
// una diferencia de potencial ΔV y entra perpendicularmente en un campo magnético entrante (⊗).
// Con v hacia la derecha y B entrante, F = q v × B apunta hacia arriba: el protón describe media
// circunferencia en sentido antihorario y sale del campo. El dibujo no está a escala.
interface Props {
  descripcion: string
}

const { descripcion } = Astro.props
const id = `proton-b-${Math.round(Math.random() * 1e9)}`
const R = 70
const entrada = { x: 130, y: 178 }
const centro = { x: entrada.x, y: entrada.y - R }
const cruces = [0, 1, 2, 3, 4].flatMap((i) => [0, 1, 2, 3, 4].map((j) => ({ x: 150 + i * 44, y: 24 + j * 40 })))
const colores = ["#111", "#195c51", "#b04a3a"]
const marca = (color: string) => `url(#${id}-${colores.indexOf(color)})`
---

<figure class="solution-figure">
  <svg viewBox="0 0 360 214" role="img" aria-label={descripcion}>
    <defs>
      {
        colores.map((color, i) => (
          <marker id={`${id}-${i}`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M0 0L10 5L0 10z" fill={color} />
          </marker>
        ))
      }
    </defs>
    <rect x="130" y="8" width="226" height="200" fill="rgba(201, 188, 232, 0.18)" stroke="#999" stroke-dasharray="4 3" />
    <g stroke="#bbb" stroke-width="1">
      {cruces.map((c) => <path d={`M${c.x - 3} ${c.y - 3}l6 6m0-6l-6 6`} />)}
    </g>
    <text x="350" y="200" text-anchor="end" font-family="Arial, Helvetica, sans-serif" font-size="11" font-style="italic" fill="#555">B (entrante)</text>

    <g stroke="#111" stroke-width="2.4">
      <path d="M30 150V200" />
      <path d="M90 150V172M90 184V200" />
    </g>
    <g font-family="Arial, Helvetica, sans-serif" font-size="11" fill="#111">
      <text x="30" y="144" text-anchor="middle">+</text>
      <text x="90" y="144" text-anchor="middle">−</text>
      <text x="60" y="140" text-anchor="middle" font-style="italic">ΔV</text>
    </g>

    <path d={`M36 ${entrada.y}H${entrada.x}`} stroke="#555" stroke-width="1.2" stroke-dasharray="4 3" fill="none" />
    <path
      d={`M${entrada.x} ${entrada.y}A${R} ${R} 0 0 0 ${entrada.x} ${entrada.y - 2 * R}`}
      stroke="#2d6fa3"
      stroke-width="1.8"
      fill="none"
    />
    <path d={`M${entrada.x} ${entrada.y - 2 * R}h-40`} stroke="#2d6fa3" stroke-width="1.8" fill="none" marker-end={marca("#111")} />
    <circle cx="36" cy={entrada.y} r="5" fill="#fff" stroke="#111" stroke-width="1.2" />
    <text x="36" y={entrada.y + 3.5} text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="9" font-weight="700">+</text>

    <path d={`M${centro.x} ${centro.y}L${centro.x + R * Math.cos(Math.PI / 4)} ${centro.y + R * Math.sin(Math.PI / 4)}`} stroke="#555" stroke-width="1" stroke-dasharray="3 3" />
    <circle cx={centro.x} cy={centro.y} r="2" fill="#555" />
    <g stroke-width="1.7" fill="none">
      <path d={`M${centro.x + R} ${centro.y}V${centro.y - 38}`} stroke="#195c51" marker-end={marca("#195c51")} />
      <path d={`M${centro.x + R} ${centro.y}H${centro.x + R - 40}`} stroke="#b04a3a" marker-end={marca("#b04a3a")} />
    </g>
    <g font-family="Arial, Helvetica, sans-serif" font-size="12" font-weight="700">
      <text x={centro.x + R + 6} y={centro.y - 30} fill="#195c51">v</text>
      <text x={centro.x + R - 42} y={centro.y - 6} fill="#b04a3a">F</text>
      <text x={centro.x + 30} y={centro.y + 38} fill="#555" font-weight="400" font-style="italic">r</text>
    </g>
  </svg>
</figure>
