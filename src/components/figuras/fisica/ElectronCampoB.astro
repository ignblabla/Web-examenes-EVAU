---
// Física, reserva 2 de 2025, B b1: electrón que entra con velocidad +i en un campo B = 0,2 j T.
// Se dibuja el plano XZ visto con el eje Y saliendo del papel (B saliente, ⊙); con X hacia la
// derecha, el eje Z queda hacia abajo. La fuerza F = −e v × B apunta hacia −k, es decir, hacia
// arriba en el dibujo, y el electrón describe una circunferencia en el plano XZ.
const id = `electron-b-${Math.round(Math.random() * 1e9)}`
const puntos = [0, 1, 2, 3, 4].flatMap((i) => [0, 1, 2, 3].map((j) => ({ x: 150 + i * 44, y: 30 + j * 44 })))
const entrada = { x: 160, y: 162 }
const r = 60
---

<figure class="solution-figure">
  <svg viewBox="0 0 380 210" role="img" aria-label="Plano XZ con el eje Y saliendo del papel y el eje Z hacia abajo. El campo B, en el sentido del eje Y, sale del papel. El electrón entra con velocidad hacia la derecha; la fuerza magnética sobre él apunta en el sentido negativo del eje Z, hacia arriba en el dibujo, y lo hace girar en una circunferencia en sentido antihorario dentro del plano XZ.">
    <defs>
      <marker id={`${id}-n`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" fill="#111" />
      </marker>
      <marker id={`${id}-v`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" fill="#195c51" />
      </marker>
      <marker id={`${id}-r`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" fill="#b04a3a" />
      </marker>
      <marker id={`${id}-a`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" fill="#2d6fa3" />
      </marker>
    </defs>
    <g fill="none" stroke="#bbb" stroke-width="1">
      {puntos.map((p) => <circle cx={p.x} cy={p.y} r="4" />)}
    </g>
    <g fill="#bbb">
      {puntos.map((p) => <circle cx={p.x} cy={p.y} r="1.2" />)}
    </g>
    <text x="370" y="20" text-anchor="end" font-family="Arial, Helvetica, sans-serif" font-size="11" font-weight="700" fill="#888">B (eje Y, saliente)</text>

    <g stroke="#111" stroke-width="1">
      <path d="M20 40h40" marker-end={`url(#${id}-n)`} />
      <path d="M20 40v40" marker-end={`url(#${id}-n)`} />
      <circle cx="20" cy="40" r="5" fill="#fff" />
      <circle cx="20" cy="40" r="1.6" fill="#111" />
    </g>
    <g font-family="Arial, Helvetica, sans-serif" font-size="11" font-style="italic" fill="#111">
      <text x="64" y="44">x</text>
      <text x="16" y="94">z</text>
      <text x="6" y="30">y</text>
    </g>

    <path d={`M${entrada.x} ${entrada.y}A${r} ${r} 0 1 0 ${entrada.x - 0.1} ${entrada.y}`} fill="none" stroke="#2d6fa3" stroke-width="2" stroke-dasharray="6 4" />
    <path d={`M90 ${entrada.y}H${entrada.x - 2}`} stroke="#195c51" stroke-width="1.8" marker-end={`url(#${id}-v)`} />
    <text x="112" y={entrada.y - 8} font-family="Arial, Helvetica, sans-serif" font-size="12" font-style="italic" font-weight="700" fill="#195c51">v</text>
    <path d={`M${entrada.x} ${entrada.y}V${entrada.y - 46}`} stroke="#b04a3a" stroke-width="1.8" marker-end={`url(#${id}-r)`} />
    <text x={entrada.x + 6} y={entrada.y - 36} font-family="Arial, Helvetica, sans-serif" font-size="12" font-weight="700" fill="#b04a3a">F</text>
    <circle cx={entrada.x} cy={entrada.y} r="5" fill="#d8e5ed" stroke="#111" />
    <text x={entrada.x} y={entrada.y + 20} text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="10" fill="#111">e⁻</text>
    <path d={`M${entrada.x + r} ${entrada.y - r - 4}v-2`} stroke="#2d6fa3" stroke-width="2" marker-end={`url(#${id}-a)`} />
    <text x={entrada.x + r + 10} y={entrada.y - r + 4} font-family="Arial, Helvetica, sans-serif" font-size="10" fill="#2d6fa3">trayectoria circular</text>
  </svg>
</figure>
