---
// Física, reserva 2 de 2025, B a: hilo en el eje OY con la corriente hacia +y y una espira
// circular a su derecha, donde el campo del hilo es entrante (⊗). i) Si la corriente aumenta,
// el flujo entrante aumenta: campo inducido saliente y corriente antihoraria. ii) Si la espira
// se aleja, el flujo entrante disminuye: campo inducido entrante y corriente horaria.
// Con casos se eligen los dos paneles (por defecto, los de 2025); «acerca» es el de la reserva 1
// de 2024: al acercarse la espira, el flujo entrante aumenta y la corriente es antihoraria.
// «paralela» (reserva 3 de 2022): la espira se mueve paralela al hilo, en el sentido de la
// corriente; el campo que la atraviesa no cambia y no hay corriente inducida.
// Con cuadrada, la espira es un cuadrado (reserva 4 de 2021, B2 a).
type Caso = "aumenta" | "aleja" | "acerca" | "paralela"
interface Props {
  casos?: [Caso, Caso]
  cuadrada?: boolean
}
const { casos = ["aumenta", "aleja"], cuadrada = false } = Astro.props
const id = `espira-circular-${Math.round(Math.random() * 1e9)}`
const datos = {
  aumenta: { titulo: "Aumenta la corriente I", horaria: false, v: 0, nota: "B inducido saliente · I antihoraria" },
  aleja: { titulo: "La espira se aleja", horaria: true, v: 1, nota: "B inducido entrante · I horaria" },
  acerca: { titulo: "La espira se acerca", horaria: false, v: -1, nota: "B inducido saliente · I antihoraria" },
  paralela: { titulo: "Se mueve paralela al hilo", horaria: false, v: 2, nota: "Flujo constante · no hay corriente inducida" },
}
const paneles = casos.map((caso, i) => ({ x0: i * 250, ...datos[caso], titulo: `${i === 0 ? "i" : "ii"}) ${datos[caso].titulo}` }))
const descripcion = `Dos esquemas de un hilo vertical con la corriente hacia arriba y una espira ${cuadrada ? "cuadrada" : "circular"} a su derecha, donde el campo del hilo entra en el papel. ${paneles
  .map((p) =>
    p.v === 2
      ? `${p.titulo.slice(4)}, hacia arriba: el flujo no cambia y no hay corriente inducida.`
      : `${p.titulo.slice(4)}: el campo inducido en la espira es ${p.horaria ? "entrante" : "saliente"} y la corriente inducida circula en sentido ${p.horaria ? "horario" : "antihorario"}.`,
  )
  .join(" ")}`
const cruces = [0, 1, 2, 3].flatMap((i) => [0, 1, 2, 3].map((j) => ({ dx: 46 + i * 40, y: 46 + j * 38 })))
// Arco de la corriente inducida: tres cuartos de circunferencia con la flecha en el sentido pedido.
const arco = (cx: number, cy: number, r: number, horaria: boolean) =>
  horaria
    ? `M${cx} ${cy - r}A${r} ${r} 0 1 1 ${cx - r} ${cy}`
    : `M${cx} ${cy - r}A${r} ${r} 0 1 0 ${cx + r} ${cy}`
---

<figure class="solution-figure solution-figure--wide">
  <svg viewBox="0 0 500 210" role="img" aria-label={descripcion}>
    <defs>
      <marker id={`${id}-n`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" fill="#111" />
      </marker>
      <marker id={`${id}-r`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" fill="#b04a3a" />
      </marker>
      <marker id={`${id}-v`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" fill="#195c51" />
      </marker>
    </defs>
    {
      paneles.map((p) => (
        <g>
          <text x={p.x0 + 6} y="16" font-family="Arial, Helvetica, sans-serif" font-size="11" font-weight="700" fill="#111">{p.titulo}</text>
          <path d={`M${p.x0 + 24} 190V30`} stroke="#111" stroke-width="3" />
          <path d={`M${p.x0 + 14} 130V80`} stroke="#111" stroke-width="1.4" marker-end={`url(#${id}-n)`} />
          <text x={p.x0 + 10} y="112" text-anchor="end" font-family="Arial, Helvetica, sans-serif" font-size="12" font-style="italic">I</text>
          <g stroke="#bbb" stroke-width="1">
            {cruces.map((c) => (
              <path d={`M${p.x0 + c.dx - 3} ${c.y - 3}l6 6m0 -6l-6 6`} />
            ))}
          </g>
          {cuadrada ? (
            <rect x={p.x0 + 88} y="62" width="84" height="84" fill="rgba(201, 188, 232, 0.25)" stroke="#172c27" stroke-width="2" />
          ) : (
            <circle cx={p.x0 + 130} cy="104" r="44" fill="rgba(201, 188, 232, 0.25)" stroke="#172c27" stroke-width="2" />
          )}
          {p.v !== 2 && <path d={arco(p.x0 + 130, 104, 32, p.horaria)} fill="none" stroke="#b04a3a" stroke-width="1.6" marker-end={`url(#${id}-r)`} />}
          {p.v !== 2 && <circle cx={p.x0 + 130} cy="104" r="8" fill="#fff" stroke="#b04a3a" stroke-width="1.4" />}
          {p.v === 2 ? null : p.horaria ? (
            <path d={`M${p.x0 + 124.5} 98.5l11 11m0 -11l-11 11`} stroke="#b04a3a" stroke-width="1.4" />
          ) : (
            <circle cx={p.x0 + 130} cy="104" r="2.2" fill="#b04a3a" />
          )}
          {p.v === 2 && (
            <g>
              <path d={`M${p.x0 + 194} 130V86`} stroke="#195c51" stroke-width="1.8" marker-end={`url(#${id}-v)`} />
              <text x={p.x0 + 202} y="112" font-family="Arial, Helvetica, sans-serif" font-size="12" font-style="italic" font-weight="700" fill="#195c51">v</text>
            </g>
          )}
          {(p.v === 1 || p.v === -1) && (
            <g>
              <path d={p.v > 0 ? `M${p.x0 + 180} 104h28` : `M${p.x0 + 208} 104h-28`} stroke="#195c51" stroke-width="1.8" marker-end={`url(#${id}-v)`} />
              <text x={p.x0 + 194} y="96" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="12" font-style="italic" font-weight="700" fill="#195c51">v</text>
            </g>
          )}
          <text x={p.x0 + 130} y="200" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="10" fill="#b04a3a">{p.nota}</text>
        </g>
      ))
    }
  </svg>
</figure>
