---
// Matemáticas aplicadas, reserva 1 de 2024, ejercicio 2: región factible de los centros florales (x)
// y candelabros (y).
import RegionFactible from "./RegionFactible.astro"
---

<RegionFactible
  xMax={44}
  yMax={16}
  marcasX={[10, 20, 30, 40]}
  marcasY={[5, 10, 15]}
  rectas={[
    { desde: [0, 0], hasta: [44, 44 / 3], color: "#5b3f8c", etiqueta: "x = 3y", en: [36, 13.5], ancla: "end" },
    { desde: [0, 12], hasta: [12, 0], color: "#2f6fa3", etiqueta: "x + y = 12", en: [3.5, 10] },
    { desde: [24, 16], hasta: [40, 0], color: "#7a5b16", etiqueta: "x + y = 40", en: [36, 6] },
  ]}
  region={[
    [12, 0],
    [40, 0],
    [30, 10],
    [9, 3],
  ]}
  vertices={[
    { x: 12, y: 0, texto: "A", dx: -6, dy: -5 },
    { x: 40, y: 0, texto: "B", dx: 6, dy: -5 },
    { x: 30, y: 10, texto: "C", dx: 0, dy: -9 },
    { x: 9, y: 3, texto: "D", dx: -7, dy: -3 },
  ]}
  descripcion="Región factible: cuadrilátero de vértices A(12, 0), B(40, 0), C(30, 10) y D(9, 3), limitado por el eje OX y las rectas x + y = 12, x + y = 40 y x = 3y"
/>
