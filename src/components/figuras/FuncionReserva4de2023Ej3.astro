---
// Matemáticas aplicadas, reserva 4 de 2023, ejercicio 3: f(x) = (x − 2)² para x < 3 y
// −x + 4 para x ≥ 3, con el recinto entre la gráfica y el eje OX de x = 2 a x = 4.
import GraficaFuncion from "./GraficaFuncion.astro"

const f = (x: number) => (x < 3 ? (x - 2) ** 2 : -x + 4)
---

<GraficaFuncion
  xMin={-0.6}
  xMax={5.5}
  yMin={-1.6}
  yMax={4.8}
  marcasX={[1, 3, 5]}
  marcasY={[1, 2, 3, 4]}
  tramos={[{ f, desde: -0.15, hasta: 5.5 }]}
  recinto={{ arriba: f, abajo: () => 0, desde: 2, hasta: 4 }}
  puntos={[
    { x: 0, y: 4, texto: "(0, 4)", dx: 6, dy: -4 },
    { x: 2, y: 0, texto: "(2, 0)", dx: 0, dy: 15 },
    { x: 3, y: 1, texto: "(3, 1)", dx: 6, dy: -6 },
    { x: 4, y: 0, texto: "(4, 0)", dx: 0, dy: 15 },
  ]}
  descripcion="Gráfica de f: parábola con vértice en (2, 0) hasta el punto (3, 1), donde forma un pico, y después la recta −x + 4, que corta al eje en (4, 0); el recinto con el eje entre x = 2 y x = 4 está sombreado"
/>
