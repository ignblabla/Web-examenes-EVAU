---
// Matemáticas aplicadas, reserva 4 de 2026, ejercicio 1 B): recinto de 3x − 4y ≤ 6, x + y ≤ 9,
// x + 4y ≤ 24, 3x + 2y ≥ 6, x ≥ 0.
import RegionFactible from "./RegionFactible.astro"
---

<RegionFactible
  xMax={10}
  yMax={7.5}
  marcasX={[4, 6, 8]}
  marcasY={[2, 4, 6]}
  rectas={[
    { desde: [2, 0], hasta: [10, 6], color: "#b04a3a", etiqueta: "3x − 4y = 6", en: [7.4, 2.5] },
    { desde: [1.5, 7.5], hasta: [9, 0], color: "#7a5b16", etiqueta: "x + y = 9", en: [5.5, 1] },
    { desde: [0, 6], hasta: [10, 3.5], color: "#2f6fa3", etiqueta: "x + 4y = 24", en: [6.4, 5] },
    { desde: [0, 3], hasta: [2, 0], color: "#5b3f8c", etiqueta: "3x + 2y = 6", en: [0.75, 2.15] },
  ]}
  region={[
    [0, 3],
    [2, 0],
    [6, 3],
    [4, 5],
    [0, 6],
  ]}
  vertices={[
    { x: 0, y: 3, texto: "A", dx: -6, dy: 4 },
    { x: 2, y: 0, texto: "B", dx: 0, dy: 14 },
    { x: 6, y: 3, texto: "C", dx: 7, dy: 4 },
    { x: 4, y: 5, texto: "D", dx: 5, dy: -6 },
    { x: 0, y: 6, texto: "E", dx: 6, dy: -6 },
  ]}
  descripcion="Recinto: pentágono de vértices A(0, 3), B(2, 0), C(6, 3), D(4, 5) y E(0, 6), limitado por el eje OY y las rectas 3x + 2y = 6, 3x − 4y = 6, x + y = 9 y x + 4y = 24"
/>
