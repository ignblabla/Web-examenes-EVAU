---
// Matemáticas aplicadas, reserva 2 de 2024, ejercicio 4 c): f(x) = 3 + eˣ si x < 1 y
// x² − 3x + 2 si x ≥ 1 (a = −3); recinto con el eje entre x = 2 y x = 4.
import GraficaFuncion from "./GraficaFuncion.astro"

const f = (x: number) => (x < 1 ? 3 + Math.exp(x) : x ** 2 - 3 * x + 2)
---

<GraficaFuncion
  xMin={-2}
  xMax={5}
  yMin={-1.5}
  yMax={8}
  marcasX={[-1, 1, 2, 3, 4]}
  marcasY={[2, 4, 6]}
  tramos={[
    { f, desde: -2, hasta: 0.999 },
    { f, desde: 1, hasta: 4.7 },
  ]}
  recinto={{ arriba: f, abajo: () => 0, desde: 2, hasta: 4 }}
  puntos={[
    { x: 0, y: 4, texto: "(0, 4)", dx: -6, dy: -6 },
    { x: 2, y: 0, texto: "(2, 0)", dx: -6, dy: -6 },
    { x: 4, y: 6, texto: "(4, 6)", dx: -7, dy: -2 },
  ]}
  descripcion="Gráfica de f para a = −3: la rama 3 + eˣ crece hasta cerca de 5.7 y en x = 1 la función salta a la parábola x² − 3x + 2, que corta el eje en (1, 0) y (2, 0); el recinto bajo la parábola entre x = 2 y x = 4 está sombreado"
/>
