---
// Matemáticas aplicadas, junio de 2024, ejercicio 4: velocidad del viento v(t) en km/h a lo largo
// del día, con el umbral de 100 km/h del aviso naranja.
import GraficaFuncion from "./GraficaFuncion.astro"

const v = (t: number) => (t <= 10 ? t ** 2 - 8 * t + 60 : -(t ** 2) + 32 * t - 140)
---

<GraficaFuncion
  xMin={-1}
  xMax={25}
  yMin={0}
  yMax={132}
  marcasX={[4, 8, 12, 16, 20, 24]}
  marcasY={[20, 40, 60, 80, 100, 120]}
  tramos={[{ f: v, desde: 0, hasta: 24 }]}
  asintotas={[{ tipo: "h", valor: 100, etiqueta: "100 km/h" }]}
  puntos={[
    { x: 0, y: 60, texto: "(0, 60)", dx: 6, dy: -6 },
    { x: 4, y: 44, texto: "Mínimo (4, 44)", dx: 0, dy: 16 },
    { x: 10, y: 80, texto: "(10, 80)", dx: 8, dy: 4 },
    { x: 12, y: 100 },
    { x: 16, y: 116, texto: "Máximo (16, 116)", dx: 0, dy: -9 },
    { x: 20, y: 100 },
    { x: 24, y: 52, texto: "(24, 52)", dx: -6, dy: 0 },
  ]}
  descripcion="Gráfica de la velocidad del viento: baja de 60 a un mínimo de 44 km/h a las 4 horas, sube hasta un máximo de 116 km/h a las 16 horas y baja hasta 52 km/h a las 24 horas; supera los 100 km/h entre las 12 y las 20 horas"
/>
