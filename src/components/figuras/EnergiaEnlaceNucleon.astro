---
// Física, junio 2023, D2: energía de enlace por nucleón frente al número másico A.
// Ocupa la altura de los dos apartados del ejercicio (a y b), como en el examen.
const puntos = [
  [40, 150],
  [44, 96],
  [49, 72],
  [55, 60],
  [62, 53],
  [70, 49],
  [80, 46],
  [96, 44],
  [112, 45],
  [128, 47],
  [146, 50],
  [164, 53],
  [182, 57],
  [200, 61],
  [214, 65],
]
---

<figure class="official-figure official-figure--tall">
  <svg
    viewBox="0 0 232 262"
    role="img"
    aria-label="Gráfica de la energía de enlace por nucleón frente al número másico A: crece rápidamente desde el hidrógeno-2, el helio-4 queda por encima de la curva, alcanza el máximo en el hierro-56 y desciende lentamente hasta el uranio-238"
  >
    <g fill="none" stroke="#111" stroke-width="1.2">
      <path d="M30 8V236H226" />
      <path d="M36 224C37 170 40 112 47 80S66 50 96 44 180 52 216 66" stroke-width="1.6" />
    </g>
    <g fill="#111">
      {puntos.map(([x, y]) => <circle cx={x} cy={y} r="1.6" />)}
      <circle cx="40" cy="40" r="2" />
      <circle cx="37" cy="218" r="2" />
    </g>
    <g font-family="Arial, Helvetica, sans-serif" fill="#111">
      <text x="46" y="22" font-size="13"><tspan font-size="8" dy="-5">4</tspan><tspan dy="5">He</tspan></text>
      <text x="110" y="22" font-size="13"><tspan font-size="8" dy="-5">56</tspan><tspan dy="5">Fe</tspan></text>
      <text x="196" y="90" font-size="13"><tspan font-size="8" dy="-5">238</tspan><tspan dy="5">U</tspan></text>
      <text x="48" y="220" font-size="13"><tspan font-size="8" dy="-5">2</tspan><tspan dy="5">H</tspan></text>
      <text x="128" y="256" font-size="12">A</text>
      <text transform="translate(16 218) rotate(-90)" font-size="11.5">Energía de enlace por nucleón</text>
    </g>
  </svg>
</figure>
