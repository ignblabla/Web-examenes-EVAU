---
// Matemáticas aplicadas, julio de 2025, ejercicio 2: región factible de las lechugas iceberg (x)
// y romana (y). El mínimo del consumo de agua está en el vértice A.
import RegionFactible from "./RegionFactible.astro"
---

<RegionFactible
  xMax={2600}
  yMax={2500}
  marcasX={[500, 2000]}
  marcasY={[500, 1000, 1500, 2000]}
  rectas={[
    { desde: [0, 0], hasta: [1250, 2500], color: "#5b3f8c", etiqueta: "y = 2x", en: [1100, 2350], ancla: "end" },
    { desde: [1500, 0], hasta: [1500, 2500], color: "#b04a3a", etiqueta: "x = 1500", en: [1540, 2350] },
    { desde: [0, 900], hasta: [900, 0], color: "#2f6fa3", etiqueta: "x + y = 900", en: [430, 150], ancla: "middle" },
    { desde: [0, 2400], hasta: [2400, 0], color: "#7a5b16", etiqueta: "x + y = 2400", en: [1950, 620] },
  ]}
  region={[
    [900, 0],
    [1500, 0],
    [1500, 900],
    [800, 1600],
    [300, 600],
  ]}
  vertices={[
    { x: 900, y: 0, texto: "A", dx: 0, dy: 14 },
    { x: 1500, y: 0, texto: "B", dx: 0, dy: 14 },
    { x: 1500, y: 900, texto: "C", dx: 6, dy: 4 },
    { x: 800, y: 1600, texto: "D", dx: 6, dy: -4 },
    { x: 300, y: 600, texto: "E", dx: -6, dy: 4 },
  ]}
  descripcion="Región factible: pentágono de vértices A(900, 0), B(1500, 0), C(1500, 900), D(800, 1600) y E(300, 600), limitado por el eje OX y las rectas y = 2x, x = 1500, x + y = 900 y x + y = 2400"
/>
