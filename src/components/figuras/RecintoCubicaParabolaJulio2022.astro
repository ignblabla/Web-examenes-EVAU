---
// Matemáticas II, julio de 2022, ejercicio 4: f(x) = x³ + 2 y g(x) = −x² + 2x + 2, que se cortan en
// x = −2, 0 y 1. Se sombrea el recinto del primer cuadrante, entre x = 0 y x = 1.
import GraficaFuncion from "./GraficaFuncion.astro"

const f = (x: number) => x ** 3 + 2
const g = (x: number) => -(x ** 2) + 2 * x + 2
---

<GraficaFuncion
  xMin={-2.8}
  xMax={2.4}
  yMin={-7.4}
  yMax={6.4}
  marcasX={[-2, -1, 1, 2]}
  marcasY={[-6, -4, -2, 2, 4, 6]}
  tramos={[
    { f, desde: -2.35, hasta: 1.6, etiqueta: { texto: "f", x: 1.75, y: 5.6, ancla: "end" } },
    { f: g, desde: -2.35, hasta: 2.35, color: "#b04a3a", etiqueta: { texto: "g", x: 2.3, y: 0.6, ancla: "end" } },
  ]}
  recinto={{ arriba: g, abajo: f, desde: 0, hasta: 1 }}
  puntos={[
    { x: -2, y: -6, texto: "(−2, −6)", dx: 10, dy: 4 },
    { x: 0, y: 2, texto: "(0, 2)", dx: -8, dy: -6 },
    { x: 1, y: 3, texto: "(1, 3)", dx: 8, dy: -8 },
  ]}
  descripcion="Gráficas de la cúbica f(x) = x³ + 2 y de la parábola g(x) = −x² + 2x + 2, con vértice en (1, 3). Se cortan en (−2, −6), (0, 2) y (1, 3). Está sombreado el recinto del primer cuadrante, entre x = 0 y x = 1, con la parábola por arriba y la cúbica por abajo"
/>
