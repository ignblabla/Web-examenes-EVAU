---
// Matemáticas aplicadas, reserva 4 de 2024, ejercicio 4: f es la parábola −x²/2 + x + 1 hasta x = 2 y
// 1/(x − 1) después, con asíntota y = 0; recinto con el eje entre x = 0 y x = 4 (apartado b).
import GraficaFuncion from "./GraficaFuncion.astro"

const f = (x: number) => (x <= 2 ? -(x ** 2) / 2 + x + 1 : 1 / (x - 1))
---

<GraficaFuncion
  xMin={-1.5}
  xMax={6}
  yMin={-1}
  yMax={2}
  marcasX={[-1, 1, 2, 3, 4, 5]}
  marcasY={[0.5, 1.5]}
  tramos={[{ f, desde: -1.2, hasta: 6 }]}
  recinto={{ arriba: f, abajo: () => 0, desde: 0, hasta: 4 }}
  puntos={[
    { x: 0, y: 1, texto: "(0, 1)", dx: -6, dy: -6 },
    { x: 1, y: 1.5, texto: "Máximo (1, 1.5)", dx: 0, dy: -9 },
    { x: 2, y: 1, texto: "(2, 1)", dx: 6, dy: -4 },
    { x: 4, y: 1 / 3, texto: "(4, ⅓)", dx: 6, dy: -6 },
  ]}
  descripcion="Gráfica de f: la parábola sube hasta el máximo (1, 1.5), baja hasta (2, 1) y enlaza suavemente con la curva 1/(x − 1), que sigue bajando y se acerca al eje X; el recinto entre x = 0 y x = 4 está sombreado"
/>
