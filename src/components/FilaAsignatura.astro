---
// Tarjeta de asignatura en forma de fila de índice: escala igual con 2 que con 15.
import Icono from './Icono.astro';
import { estiloAcento, type Asignatura } from '../config/asignaturas';
interface Props { asignatura: Asignatura; resueltos?: number; total?: number; desde?: number; hasta?: number }
const { asignatura: a, resueltos = 0, total = 0, desde, hasta } = Astro.props;
---
{a.disponible ? (
  <li class="fa" data-acento style={estiloAcento(a)}>
    <span class="fa__icono"><Icono nombre={a.icono} tamano={28} /></span>
    <div class="fa__cuerpo">
      <h3 class="fa__nombre"><a href={`/${a.slug}/`}>{a.nombre}</a></h3>
      <p class="fa__desc">{a.descripcion}</p>
    </div>
    <dl class="fa__meta">
      <div><dt>Resueltos</dt><dd class="num">{resueltos}<span> de {total}</span></dd></div>
      {desde && <div><dt>Años</dt><dd class="num">{desde}–{hasta}</dd></div>}
    </dl>
    <Icono nombre="flecha" class="fa__flecha" />
  </li>
) : (
  <li class="fa fa--pronto" data-acento style={estiloAcento(a)}>
    <span class="fa__icono"><Icono nombre={a.icono} tamano={22} /></span>
    <h3 class="fa__nombre"><a href={`/${a.slug}/`}>{a.nombreCorto}</a></h3>
    <span class="etiqueta fa__estado"><span class="casilla" data-estado="pendiente" aria-hidden="true"></span>Próximamente</span>
  </li>
)}

<style>
  .fa {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-areas: 'icono cuerpo flecha' 'icono meta flecha';
    align-items: center;
    gap: var(--s-2) var(--s-4);
    padding: var(--s-4) var(--s-2) var(--s-4) 0;
    border-bottom: var(--b-hair) solid var(--rule-ink);
    transition: background-color var(--dur-2) var(--ease-out);
  }
  .fa:first-child { border-top: var(--b-form) solid var(--rule-ink); }
  .fa:hover { background: var(--fill); }
  .fa__icono {
    grid-area: icono; align-self: start;
    display: grid; place-items: center;
    width: 3.5rem; height: 3.5rem;
    background: var(--acc); color: var(--on-acc);
  }
  .fa__cuerpo { grid-area: cuerpo; min-width: 0; }
  .fa__nombre {
    font: 800 var(--t-lg)/1.02 var(--f-frame);
    font-stretch: var(--stretch-frame);
    text-transform: uppercase; letter-spacing: 0.01em;
    text-wrap: balance;
  }
  .fa__nombre a { text-decoration: none; }
  .fa__nombre a::after { content: ''; position: absolute; inset: 0; }
  .fa__nombre a:focus-visible { outline: none; }
  .fa:has(a:focus-visible) { outline: 2px solid var(--acc); outline-offset: 2px; }
  .fa__desc { margin-top: var(--s-1); font-size: var(--t-sm); line-height: 1.45; color: var(--ink-2); }
  .fa__meta { grid-area: meta; display: flex; gap: var(--s-5); }
  .fa__meta dt {
    font: 650 var(--t-2xs)/1.2 var(--f-frame); font-stretch: var(--stretch-frame);
    text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-3);
  }
  .fa__meta dd { font: 700 var(--t-md)/1.2 var(--f-frame); font-stretch: 90%; }
  .fa__meta dd span { font-weight: 500; color: var(--ink-3); }
  :global(.fa__flecha) { grid-area: flecha; color: var(--acc); transition: translate var(--dur-2) var(--ease-out); }
  .fa:hover :global(.fa__flecha) { translate: 4px 0; }

  .fa--pronto {
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-areas: 'icono cuerpo estado';
    padding-block: var(--s-3);
    border-bottom-style: dashed;
    border-bottom-color: var(--rule);
  }
  .fa--pronto:first-child { border-top: var(--b-hair) dashed var(--rule); }
  .fa--pronto .fa__icono {
    width: 2.5rem; height: 2.5rem;
    /* El acento llega cuando la asignatura se publica; hasta entonces, tinta */
    background: none; color: var(--ink-2);
    border: var(--b-hair) solid var(--rule-ink);
  }
  .fa--pronto .fa__nombre { grid-area: cuerpo; font-size: var(--t-md); font-weight: 700; color: var(--ink-2); }
  .fa__estado { grid-area: estado; }

  @media (min-width: 48rem) {
    .fa:not(.fa--pronto) {
      grid-template-columns: auto minmax(0, 1fr) auto auto;
      grid-template-areas: 'icono cuerpo meta flecha';
      gap: var(--s-5);
      padding-block: var(--s-5);
    }
    .fa:not(.fa--pronto) .fa__icono { width: 4.5rem; height: 4.5rem; }
    .fa:not(.fa--pronto) .fa__nombre { font-size: var(--t-xl); }
    .fa__meta { justify-content: end; min-width: 13rem; }
  }
</style>
