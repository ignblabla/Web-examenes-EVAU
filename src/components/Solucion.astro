---
// Solución de un ejercicio, intercalada en el enunciado justo después de la pregunta.
// Va en español aunque el enunciado esté en inglés o en francés.
interface Props {
  titulo?: string
}

const { titulo = "Solución" } = Astro.props
---

<div class="solution" lang="es">
  <p class="solution-label">{titulo}</p>
  <slot />
</div>
