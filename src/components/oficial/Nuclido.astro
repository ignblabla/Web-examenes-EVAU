---
// Núclido con el número másico encima y el atómico debajo, a la izquierda del símbolo:
// <Nuclido a="27" z="13">Al</Nuclido>
interface Props {
  a: string
  z: string
}

const { a, z } = Astro.props
---

<span class="nuclide"><span class="nuclide-numbers"><span>{a}</span><span>{z}</span></span><slot /></span>
