---
import Icono from './Icono.astro';
interface Props { seccion?: string }
const { seccion } = Astro.props;
const links = [
  { href: '/#asignaturas', id: 'asignaturas', txt: 'Asignaturas' },
  { href: '/buscar/', id: 'buscar', txt: 'Buscar' },
  { href: '/sobre/', id: 'sobre', txt: 'Sobre el proyecto' },
];
---
<header class="cab">
  <div class="wrap cab__fila">
    <a class="marca-sitio" href="/" aria-label="PEvAU Resueltos, inicio">
      <b>PEvAU</b><span>Resueltos</span>
    </a>
    <nav class="nav" aria-label="Principal">
      <ul class="nav__links">
        {links.map((l) => (
          <li><a href={l.href} aria-current={seccion === l.id ? 'page' : undefined}>{l.txt}</a></li>
        ))}
      </ul>
      <a class="nav__btn menu-solo-movil" href="/buscar/" aria-label="Buscar"><Icono nombre="buscar" /></a>
      <button class="nav__btn" type="button" data-tema-toggle aria-pressed="false" aria-label="Cambiar tema">
        <Icono nombre="luna" class="solo-claro" />
        <Icono nombre="sol" class="solo-oscuro" />
      </button>
      <details class="menu-movil">
        <summary class="nav__btn" aria-label="Menú"><Icono nombre="menu" /></summary>
        <div class="menu-movil__panel">
          {links.map((l) => (
            <a href={l.href} aria-current={seccion === l.id ? 'page' : undefined}>{l.txt}<Icono nombre="flecha" tamano={18} /></a>
          ))}
        </div>
      </details>
    </nav>
  </div>
</header>

<style>
  /* Las clases van en el <svg> de Icono, que es otro componente: selectores globales */
  :global(.solo-oscuro) { display: none; }
  :global(:root[data-theme='dark'] .solo-oscuro) { display: block; }
  :global(:root[data-theme='dark'] .solo-claro) { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light']) .solo-oscuro) { display: block; }
    :global(:root:not([data-theme='light']) .solo-claro) { display: none; }
  }
  @media (min-width: 48rem) { .menu-solo-movil { display: none; } }
</style>

<script>
  // Cierra el menú móvil al pulsar fuera o Escape.
  const m = document.querySelector<HTMLDetailsElement>('.menu-movil');
  if (m) {
    document.addEventListener('click', (e) => { if (m.open && !m.contains(e.target as Node)) m.open = false; });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && m.open) { m.open = false; m.querySelector('summary')?.focus(); } });
  }
</script>
