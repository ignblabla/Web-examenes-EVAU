---
interface Props {
  type: "atom" | "graph" | "geometry" | "english" | "french"
}

const { type } = Astro.props
---

{
  type === "atom" && (
    <div class="atom">
      <span />
      <span />
      <span />
      <i />
    </div>
  )
}

{
  type === "english" && (
    <div class="english-symbol">
      <svg viewBox="0 0 180 150" fill="none">
        <path
          d="M90 13 79 38h22l-11-25ZM76 38h28v16H76ZM69 54h42v38H69ZM75 92h30v50H75ZM60 142h60"
          stroke="currentColor"
          stroke-width="2"
          stroke-linejoin="round"
          stroke-linecap="round"
        />
        <circle cx="90" cy="73" r="14" stroke="currentColor" stroke-width="2" />
        <path d="M90 73v-9M90 73l6 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        <path
          d="M83 42v8M90 42v8M97 42v8M84 100v36M96 100v36M75 117h30"
          stroke="currentColor"
          stroke-linecap="round"
          opacity=".45"
        />
        <circle cx="90" cy="9" r="4" fill="currentColor" />
      </svg>
    </div>
  )
}

{
  type === "geometry" && (
    <div class="geometry-symbol">
      <svg viewBox="0 0 180 130" fill="none">
        <circle cx="90" cy="65" r="52" stroke="currentColor" stroke-width="1.5" />
        <path d="M90 13 139 91H41L90 13Z" stroke="currentColor" stroke-width="2" />
        <path d="m41 91 98-38M90 13v104" stroke="currentColor" opacity=".45" />
        <circle cx="90" cy="65" r="5" fill="currentColor" />
      </svg>
    </div>
  )
}

{
  type === "french" && (
    <div class="french-symbol">
      <svg viewBox="0 0 180 150" fill="none">
        <path
          d="M90 8v14M84 22h12l6 40H78l6-40ZM74 62h32l12 40H62l12-40ZM56 102h68l18 40h-26c-4-18-14-28-26-28s-22 10-26 28H38l18-40Z"
          stroke="currentColor"
          stroke-width="2"
          stroke-linejoin="round"
        />
        <path d="M68 82h44M84 42h12" stroke="currentColor" stroke-linecap="round" opacity=".45" />
        <circle cx="90" cy="8" r="5" fill="currentColor" />
      </svg>
    </div>
  )
}

{
  type === "graph" && (
    <div class="graph">
      <svg viewBox="0 0 180 90" fill="none">
        <path d="M4 78h172M25 88V5" stroke="currentColor" opacity=".35" />
        <path
          d="M25 69c25-2 38-9 52-25 15-17 25-25 43-17 17 7 31 4 52-19"
          stroke="currentColor"
          stroke-width="2"
        />
        <circle cx="77" cy="44" r="4" fill="currentColor" />
        <circle cx="120" cy="27" r="4" fill="currentColor" />
      </svg>
    </div>
  )
}
