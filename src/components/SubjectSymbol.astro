---
interface Props {
  type: "atom" | "graph" | "geometry" | "chemistry"
}

const { type } = Astro.props
---

{
  type === "atom" && (
    <div class="atom">
      <span />
      <span />
      <span />
      <i />
    </div>
  )
}

{
  type === "chemistry" && (
    <div class="chemistry-symbol">
      <svg viewBox="0 0 180 150" fill="none">
        <path
          d="M69 18h42M79 18v42l-36 59c-7 12 1 20 14 20h66c13 0 21-8 14-20l-36-59V18"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          d="M57 99c20 7 43-8 65 0l15 25c4 8-2 15-12 15H55c-10 0-16-7-12-15l14-25Z"
          fill="currentColor"
          opacity=".18"
        />
        <circle cx="76" cy="112" r="5" fill="currentColor" />
        <circle cx="105" cy="122" r="3" fill="currentColor" />
        <circle cx="111" cy="84" r="4" fill="currentColor" />
      </svg>
    </div>
  )
}

{
  type === "geometry" && (
    <div class="geometry-symbol">
      <svg viewBox="0 0 180 130" fill="none">
        <circle cx="90" cy="65" r="52" stroke="currentColor" stroke-width="1.5" />
        <path d="M90 13 139 91H41L90 13Z" stroke="currentColor" stroke-width="2" />
        <path d="m41 91 98-38M90 13v104" stroke="currentColor" opacity=".45" />
        <circle cx="90" cy="65" r="5" fill="currentColor" />
      </svg>
    </div>
  )
}

{
  type === "graph" && (
    <div class="graph">
      <svg viewBox="0 0 180 90" fill="none">
        <path d="M4 78h172M25 88V5" stroke="currentColor" opacity=".35" />
        <path
          d="M25 69c25-2 38-9 52-25 15-17 25-25 43-17 17 7 31 4 52-19"
          stroke="currentColor"
          stroke-width="2"
        />
        <circle cx="77" cy="44" r="4" fill="currentColor" />
        <circle cx="120" cy="27" r="4" fill="currentColor" />
      </svg>
    </div>
  )
}
